---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/tailwind.css';

interface Props {
	title: string;
	description?: string;
	image?: string;
	url?: string;
}

const {
	title,
	description = "Sistema POS moderno diseñado específicamente para farmacias en México. Gestiona tu negocio de forma eficiente y profesional.",
	image = "/agoramyOpengraphw.webp",
	url = Astro.url.href
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="google-site-verification" content="0DuG0S9luclRrLFP1eM533a6YGjbmuzdeDkAtJ09_dA" />
		<link rel="icon" type="image/webp" href="/agoramiIconw.webp" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.site || Astro.url.origin).href} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(image, Astro.site || Astro.url.origin).href} />

		<!-- Google Fonts - Inter -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

		<!-- Font Awesome -->
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
		<!-- AOS (Animate On Scroll) -->
		<link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
		<!-- Cloudflare Turnstile -->
		<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

		<slot name="head" />
		
		<style is:global lang="scss">
			@reference "../styles/tailwind.css";
			@import '../styles/global.scss';
		</style>
	</head>
	<body>
		<Navbar />
		<slot />
		<Footer />

		<!-- AOS Script -->
		<script src="https://unpkg.com/aos@next/dist/aos.js" defer></script>
		<script>
			document.addEventListener('DOMContentLoaded', () => {
				AOS.init({
					duration: 1000,
					once: true,
				});

				// Navbar scroll effect
				const navbar = document.querySelector('nav');
				const navbarLogo = document.getElementById('navbar-logo');
				const scrollThreshold = 10;
				const isBlogPage = window.location.pathname.includes('/blog');

				function handleScroll() {
					if (navbar && navbarLogo) {
						const isLargeScreen = window.innerWidth >= 1024;
						const hasScrolled = window.scrollY > scrollThreshold;

						// Si es página de blog, siempre mantener fondo blanco
						if (isBlogPage) {
							navbar.style.backgroundColor = 'white';

							if (hasScrolled) {
								navbar.classList.add('border-b', 'border-gray-200');
								navbarLogo.classList.remove('h-[54px]');
								navbarLogo.classList.add('h-[50px]');
							} else {
								navbar.classList.remove('border-b', 'border-gray-200');
								navbarLogo.classList.remove('h-[50px]');
								navbarLogo.classList.add('h-[54px]');
							}
						} else {
							// Comportamiento normal para otras páginas
							if (hasScrolled) {
								// Con scroll: SIEMPRE blanco en TODAS las pantallas
								navbar.style.backgroundColor = 'white';
								navbar.classList.add('border-b', 'border-gray-200');
								navbarLogo.classList.remove('h-[54px]');
								navbarLogo.classList.add('h-[50px]');
							} else {
								// Sin scroll
								if (isLargeScreen) {
									// Pantallas grandes sin scroll: transparente
									navbar.style.backgroundColor = 'transparent';
									navbar.classList.remove('border-b', 'border-gray-200');
								} else {
									// Pantallas pequeñas sin scroll: blanco
									navbar.style.backgroundColor = 'white';
									navbar.classList.remove('border-b', 'border-gray-200');
								}
								navbarLogo.classList.remove('h-[50px]');
								navbarLogo.classList.add('h-[54px]');
							}
						}
					}
				}

				// Add scroll event listener
				window.addEventListener('scroll', handleScroll);

				// Add resize event listener
				window.addEventListener('resize', handleScroll);

				// Execute immediately to set correct initial state
				handleScroll();
			});
		</script>
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
