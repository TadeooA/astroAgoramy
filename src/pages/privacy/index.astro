---
import Layout from '../../layouts/Layout.astro';

const lastUpdated = "Mayo 2025";
const contactEmail = "contacto@agoramy.com";

const sections = [
  { id: "introduccion", title: "Introducción" },
  { id: "aceptacion", title: "Aceptación de los Términos" },
  { id: "descripcion", title: "Descripción del Servicio" },
  { id: "requisitos", title: "Requisitos de Cuenta" },
  { id: "terceros", title: "Integración con Terceros" },
  { id: "whatsapp", title: "WhatsApp Business Platform" },
  { id: "antispam", title: "Políticas Anti-spam" },
  { id: "consentimiento", title: "Consentimiento de Mensajes" },
  { id: "privacidad", title: "Privacidad y Datos" },
  { id: "almacenamiento", title: "Almacenamiento de Conversaciones" },
  { id: "suspension", title: "Suspensión de Cuentas" },
  { id: "responsabilidad", title: "Limitación de Responsabilidad" },
  { id: "disponibilidad", title: "Disponibilidad del Servicio" },
  { id: "propiedad", title: "Propiedad Intelectual" },
  { id: "facturacion", title: "Facturación y Pagos" },
  { id: "terminacion", title: "Terminación del Servicio" },
  { id: "cambios", title: "Cambios en los Términos" },
  { id: "legislacion", title: "Legislación Aplicable" },
  { id: "contacto", title: "Contacto" },
];
---

<Layout title="Términos de Uso y Privacidad — Agoramy">
  <div class="text-gray-700 min-h-screen bg-white">

    <!-- Hero -->
    <section class="pt-32 pb-16 bg-gradient-to-b from-gray-950 to-gray-900 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute top-20 left-1/4 w-72 h-72 bg-green-400 rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-emerald-500 rounded-full blur-3xl"></div>
      </div>
      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-3xl mx-auto text-center">
          <span class="inline-flex items-center gap-2 px-4 py-1.5 bg-green-500/10 border border-green-500/20 text-green-400 text-sm font-medium rounded-full mb-6">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 2a8 8 0 100 16A8 8 0 0010 2zm0 14a6 6 0 110-12 6 6 0 010 12zm1-7a1 1 0 11-2 0V7a1 1 0 112 0v2zm0 4a1 1 0 11-2 0 1 1 0 012 0z" clip-rule="evenodd" />
            </svg>
            Documento Legal
          </span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-5 leading-tight">
            Términos de Uso<br/>
            <span class="text-green-400">&amp; Privacidad</span>
          </h1>
          <p class="text-gray-400 text-lg leading-relaxed max-w-xl mx-auto">
            Al usar Agoramy / IAHub, aceptas estos términos en su totalidad. Léelos con atención antes de comenzar.
          </p>
          <div class="mt-8 flex flex-wrap justify-center gap-4 text-sm text-gray-500">
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              Última actualización: {lastUpdated}
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              19 secciones
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
              </svg>
              Versión en Español
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Content -->
    <div class="container mx-auto px-4 py-16">
      <div class="max-w-7xl mx-auto lg:grid lg:grid-cols-[280px_1fr] lg:gap-12 xl:gap-16">

        <!-- Sidebar TOC -->
        <aside class="hidden lg:block">
          <div class="sticky top-24">
            <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-4">Contenido</p>
            <nav class="space-y-0.5" id="toc">
              {sections.map((s, i) => (
                <a
                  href={`#${s.id}`}
                  class="toc-link flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-gray-500 hover:text-green-600 hover:bg-green-50 transition-all group"
                  data-section={s.id}
                >
                  <span class="w-5 h-5 rounded-md bg-gray-100 group-hover:bg-green-100 flex items-center justify-center text-[10px] font-bold text-gray-400 group-hover:text-green-600 flex-shrink-0 transition-all">
                    {i + 1}
                  </span>
                  <span class="leading-tight">{s.title}</span>
                </a>
              ))}
            </nav>
          </div>
        </aside>

        <!-- Document Body -->
        <main class="min-w-0">
          <div class="space-y-14">

            <!-- 1. Introducción -->
            <section id="introduccion" class="scroll-mt-24">
              <div class="flex items-start gap-4 mb-6">
                <span class="flex-shrink-0 w-10 h-10 rounded-xl bg-green-500 text-white text-sm font-bold flex items-center justify-center shadow-sm shadow-green-200">1</span>
                <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 pt-1.5">Introducción</h2>
              </div>
              <div class="pl-14 space-y-4 text-gray-600 leading-relaxed">
                <p>
                  Bienvenido a <strong class="text-gray-800">Agoramy</strong>, también comercializada bajo la marca <strong class="text-gray-800">IAHub</strong> (en adelante, "la Plataforma", "nosotros" o "Agoramy"). Agoramy es una plataforma SaaS multi-tenant que ofrece herramientas de automatización empresarial, gestión de conversaciones, CRM y atención al cliente a través de la integración con WhatsApp Business Platform y otras APIs de mensajería.
                </p>
                <p>
                  Los presentes Términos de Uso y la Política de Privacidad (colectivamente, "los Términos") rigen el acceso y uso de todos los servicios, funcionalidades y contenidos ofrecidos por Agoramy, accesibles a través de nuestro sitio web y aplicación.
                </p>
                <p>
                  Al registrarte, acceder o utilizar cualquier funcionalidad de Agoramy, confirmas haber leído, comprendido y aceptado vincularte a estos Términos. Si actúas en nombre de una organización, declaras tener la autoridad legal para aceptar estos Términos en su nombre.
                </p>
              </div>
            </section>

            <hr class="border-gray-100" />

            <!-- 2. Aceptación -->
            <section id="aceptacion" class="scroll-mt-24">
              <div class="flex items-start gap-4 mb-6">
                <span class="flex-shrink-0 w-10 h-10 rounded-xl bg-green-500 text-white text-sm font-bold flex items-center justify-center shadow-sm shadow-green-200">2</span>
                <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 pt-1.5">Aceptación de los Términos</h2>
              </div>
              <div class="pl-14 space-y-4 text-gray-600 leading-relaxed">
                <p>
                  El acceso y uso de Agoramy implica la aceptación plena, sin reservas, de estos Términos y de todas las políticas complementarias incorporadas por referencia. Si no aceptas estos Términos en su totalidad, debes abstenerte de usar la Plataforma.
                </p>
                <div class="bg-amber-50 border-l-4 border-amber-400 rounded-r-xl p-5">
                  <div class="flex gap-3">
                    <svg class="w-5 h-5 text-amber-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                    </svg>
                    <div>
                      <p class="font-semibold text-amber-800 mb-1">Importante</p>
                      <p class="text-amber-700 text-sm">Agoramy se reserva el derecho de modificar estos Términos en cualquier momento. Los cambios entrarán en vigor tras su publicación en la Plataforma. El uso continuado del servicio tras dichas modificaciones implica la aceptación de los nuevos términos.</p>
                    </div>
                  </div>
                </div>
                <p>
                  Debes tener al menos 18 años de edad para usar la Plataforma. Al aceptar estos Términos, declaras tener la capacidad legal para celebrar contratos vinculantes.
                </p>
              </div>
            </section>

            <hr class="border-gray-100" />

            <!-- 3. Descripción del Servicio -->
            <section id="descripcion" class="scroll-mt-24">
              <div class="flex items-start gap-4 mb-6">
                <span class="flex-shrink-0 w-10 h-10 rounded-xl bg-green-500 text-white text-sm font-bold flex items-center justify-center shadow-sm shadow-green-200">3</span>
                <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 pt-1.5">Descripción del Servicio</h2>
              </div>
              <div class="pl-14 space-y-4 text-gray-600 leading-relaxed">
                <p>Agoramy ofrece una plataforma integral de automatización empresarial y comunicación que incluye:</p>
                <div class="grid sm:grid-cols-2 gap-3 mt-2">
                  {[
                    { icon: "💬", title: "Integración WhatsApp Business", desc: "Conexión oficial con la API de WhatsApp Business Platform de Meta para gestionar conversaciones empresariales." },
                    { icon: "🤖", title: "Chatbots con IA", desc: "Creación y despliegue de chatbots inteligentes con procesamiento de lenguaje natural para automatizar la atención." },
                    { icon: "⚡", title: "Automatización de Mensajes", desc: "Flujos de trabajo automatizados para el envío y gestión de mensajes según reglas y disparadores definidos." },
                    { icon: "📊", title: "CRM Integrado", desc: "Gestión de contactos, historial de conversaciones, segmentación y seguimiento del ciclo de vida del cliente." },
                    { icon: "🎧", title: "Atención al Cliente", desc: "Panel centralizado para gestionar conversaciones multi-agente con asignación, etiquetas y métricas." },
                    { icon: "🏢", title: "Multi-tenant SaaS", desc: "Arquitectura que permite a múltiples organizaciones operar de forma aislada y segura dentro de la misma plataforma." },
                  ].map(item => (
                    <div class="flex gap-3 p-4 bg-gray-50 rounded-xl border border-gray-100">
                      <span class="text-xl flex-shrink-0">{item.icon}</span>
                      <div>
                        <p class="font-semibold text-gray-800 text-sm mb-1">{item.title}</p>
                        <p class="text-xs text-gray-500 leading-relaxed">{item.desc}</p>
                      </div>
                    </div>
                  ))}
                </div>
                <p class="text-sm text-gray-500">
                  Las funcionalidades disponibles dependen del plan de suscripción contratado. Agoramy se reserva el derecho de agregar, modificar o descontinuar funciones con notificación previa razonable.
                </p>
              </div>
            </section>

            <hr class="border-gray-100" />

            <!-- 4. Requisitos de Cuenta -->
            <section id="requisitos" class="scroll-mt-24">
              <div class="flex items-start gap-4 mb-6">
                <span class="flex-shrink-0 w-10 h-10 rounded-xl bg-green-500 text-white text-sm font-bold flex items-center justify-center shadow-sm shadow-green-200">4</span>
                <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 pt-1.5">Requisitos de Cuenta</h2>
              </div>
              <div class="pl-14 space-y-4 text-gray-600 leading-relaxed">
                <p>Para acceder a los servicios de Agoramy, debes:</p>
                <ul class="space-y-2.5">
                  {[
                    "Proporcionar información de registro verdadera, precisa, actual y completa.",
                    "Mantener y actualizar tu información de cuenta para que permanezca exacta.",
                    "Ser mayor de 18 años o contar con representación legal si eres una entidad.",
                    "Ser responsable de mantener la confidencialidad de tus credenciales de acceso.",
                    "Notificarnos de inmediato cualquier uso no autorizado de tu cuenta.",
                    "Contar con una cuenta válida de WhatsApp Business si deseas usar las funcionalidades de mensajería (sujeto a los requisitos de Meta).",
                    "Aceptar las políticas de uso de Meta y WhatsApp Business Platform de forma independiente.",
                  ].map(item => (
                    <li class="flex items-start gap-3">
                      <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                      </svg>
                      <span class="text-sm">{item}</span>
                    </li>
                  ))}
                </ul>
                <p class="text-sm">
                  Agoramy no será responsable por pérdidas derivadas del acceso no autorizado a tu cuenta cuando dicho acceso resulte de tu incumplimiento de estas obligaciones de seguridad.
                </p>
              </div>
            </section>

            <hr class="border-gray-100" />

            <!-- 5. Integración con Terceros -->
            <section id="terceros" class="scroll-mt-24">
              <div class="flex items-start gap-4 mb-6">
                <span class="flex-shrink-0 w-10 h-10 rounded-xl bg-green-500 text-white text-sm font-bold flex items-center justify-center shadow-sm shadow-green-200">5</span>
                <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 pt-1.5">Integración con Servicios de Terceros</h2>
              </div>
              <div class="pl-14 space-y-4 text-gray-600 leading-relaxed">
                <p>
                  Agoramy se integra con servicios de terceros, incluyendo pero no limitado a Meta / WhatsApp Business Platform, proveedores cloud, motores de IA y herramientas de CRM. Al usar estas integraciones, reconoces y aceptas lo siguiente:
                </p>
                <div class="space-y-3">
                  {[
                    { title: "Términos independientes", desc: "El uso de servicios de terceros está sujeto a sus propios términos y condiciones. Agoramy no controla ni es responsable de las políticas de dichos proveedores." },
                    { title: "Interrupciones de terceros", desc: "Agoramy no garantiza la disponibilidad continua de servicios de terceros. Las interrupciones, cambios de API o cancelaciones por parte de proveedores externos quedan fuera de nuestra responsabilidad." },
                    { title: "Transmisión de datos", desc: "Al usar integraciones, algunos de tus datos pueden ser transmitidos a proveedores externos. Consulta nuestra sección de Privacidad para más detalles." },
                    { title: "Cambios en APIs de terceros", desc: "Si una integración deja de estar disponible por cambios en la política del proveedor externo (ej. Meta), Agoramy hará esfuerzos razonables para notificarte, pero no podrá garantizar continuidad." },
                  ].map(item => (
                    <div class="p-4 border border-gray-200 rounded-xl">
                      <p class="font-semibold text-gray-800 text-sm mb-1">{item.title}</p>
                      <p class="text-sm text-gray-500">{item.desc}</p>
                    </div>
                  ))}
                </div>
              </div>
            </section>

            <hr class="border-gray-100" />

            <!-- 6. WhatsApp Business Platform -->
            <section id="whatsapp" class="scroll-mt-24">
              <div class="flex items-start gap-4 mb-6">
                <span class="flex-shrink-0 w-10 h-10 rounded-xl bg-green-500 text-white text-sm font-bold flex items-center justify-center shadow-sm shadow-green-200">6</span>
                <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 pt-1.5">Uso de WhatsApp Business Platform</h2>
              </div>
              <div class="pl-14 space-y-4 text-gray-600 leading-relaxed">
                <div class="bg-blue-50 border border-blue-100 rounded-xl p-5 mb-2">
                  <div class="flex gap-3 items-start">
                    <svg class="w-5 h-5 text-blue-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                    </svg>
                    <p class="text-sm text-blue-800">
                      <strong>Aviso de marca:</strong> WhatsApp™ y Meta™ son marcas registradas de <strong>Meta Platforms, Inc.</strong> Agoramy no está afiliada, patrocinada ni avalada oficialmente por Meta o WhatsApp. El uso de estas marcas es únicamente referencial para describir compatibilidad técnica.
                    </p>
                  </div>
                </div>
                <p>
                  Agoramy actúa como proveedor de soluciones de negocio (<em>Business Solution Provider</em>) que facilita el acceso a la WhatsApp Business Platform API de Meta. Al usar estas funcionalidades, el usuario acepta:
                </p>
                <ul class="space-y-2.5">
                  {[
                    "Cumplir en todo momento con las Políticas de Uso Comercial de WhatsApp Business Platform publicadas por Meta.",
                    "No usar la plataforma para enviar mensajes a números de teléfono sin consentimiento previo y documentado del destinatario.",
                    "No crear, usar ni facilitar plantillas (templates) de mensajes que contengan contenido engañoso, fraudulento o que viole las políticas de Meta.",
                    "Mantener actualizados y vigentes los perfiles de WhatsApp Business asociados a su cuenta en Agoramy.",
                    "Asumir responsabilidad total por la calificación de calidad (quality rating) de sus números registrados ante Meta.",
                    "Comprender que Meta puede restringir, suspender o eliminar acceso a la API por violaciones de política sin previo aviso.",
                    "Agoramy puede suspender el acceso a funcionalidades de WhatsApp si detecta uso que viole políticas de Meta o estas condiciones.",
                  ].map(item => (
                    <li class="flex items-start gap-3">
                      <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                      </svg>
                      <span class="text-sm">{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </section>

            <hr class="border-gray-100" />

            <!-- 7. Anti-spam -->
            <section id="antispam" class="scroll-mt-24">
              <div class="flex items-start gap-4 mb-6">
                <span class="flex-shrink-0 w-10 h-10 rounded-xl bg-green-500 text-white text-sm font-bold flex items-center justify-center shadow-sm shadow-green-200">7</span>
                <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 pt-1.5">Políticas Anti-spam y Uso Indebido</h2>
              </div>
              <div class="pl-14 space-y-4 text-gray-600 leading-relaxed">
                <p>
                  Agoramy tiene una política de cero tolerancia ante el abuso de la plataforma. El siguiente uso está estrictamente <strong class="text-red-600">prohibido</strong> y puede resultar en suspensión inmediata de la cuenta sin reembolso:
                </p>
                <div class="grid sm:grid-cols-2 gap-3">
                  {[
                    { icon: "🚫", label: "Spam masivo", desc: "Envío no solicitado de mensajes en masa a usuarios que no han otorgado consentimiento expreso." },
                    { icon: "🎣", label: "Phishing", desc: "Mensajes diseñados para engañar a destinatarios y obtener información personal, financiera o credenciales." },
                    { icon: "💸", label: "Fraude", desc: "Cualquier actividad engañosa, estafas, esquemas piramidales o promesas fraudulentas de ganancias." },
                    { icon: "🔄", label: "Campañas masivas no autorizadas", desc: "Difusión de contenido publicitario a listas sin opt-in verificado y documentado." },
                    { icon: "⚖️", label: "Actividades ilegales", desc: "Uso del servicio para fines que violen leyes locales, nacionales o internacionales aplicables." },
                    { icon: "🔓", label: "Acceso no autorizado", desc: "Intentos de acceder a datos de otros usuarios, sistemas de Agoramy o infraestructura de terceros." },
                    { icon: "🦠", label: "Malware / código malicioso", desc: "Distribución de virus, malware, ransomware o cualquier código diseñado para causar daño." },
                    { icon: "📛", label: "Suplantación de identidad", desc: "Hacerse pasar por otra persona, empresa o entidad de forma engañosa a través de la plataforma." },
                  ].map(item => (
                    <div class="flex gap-3 p-4 bg-red-50/50 border border-red-100 rounded-xl">
                      <span class="text-lg flex-shrink-0">{item.icon}</span>
                      <div>
                        <p class="font-semibold text-red-800 text-sm mb-1">{item.label}</p>
                        <p class="text-xs text-gray-500 leading-relaxed">{item.desc}</p>
                      </div>
                    </div>
                  ))}
                </div>
                <p class="text-sm">
                  Agoramy cooperará activamente con autoridades competentes ante investigaciones sobre usos ilícitos de la plataforma. Los usuarios que incurran en prácticas prohibidas serán reportados si la ley así lo exige.
                </p>
              </div>
            </section>

            <hr class="border-gray-100" />

            <!-- 8. Consentimiento -->
            <section id="consentimiento" class="scroll-mt-24">
              <div class="flex items-start gap-4 mb-6">
                <span class="flex-shrink-0 w-10 h-10 rounded-xl bg-green-500 text-white text-sm font-bold flex items-center justify-center shadow-sm shadow-green-200">8</span>
                <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 pt-1.5">Responsabilidad sobre el Consentimiento de Mensajes</h2>
              </div>
              <div class="pl-14 space-y-4 text-gray-600 leading-relaxed">
                <div class="bg-green-50 border border-green-200 rounded-xl p-5">
                  <p class="font-semibold text-green-800 mb-2">Principio fundamental</p>
                  <p class="text-green-700 text-sm">
                    El usuario de Agoramy es el <strong>único y exclusivo responsable</strong> de obtener, documentar y mantener el consentimiento previo, informado y verificable de cada destinatario antes de enviarle mensajes automatizados a través de la plataforma.
                  </p>
                </div>
                <p>
                  Agoramy proporciona la infraestructura técnica para el envío de mensajes, pero no verifica ni valida el consentimiento de los destinatarios finales. En consecuencia:
                </p>
                <ul class="space-y-3">
                  {[
                    "El usuario debe obtener opt-in explícito de cada contacto antes de incluirlo en flujos de mensajería automatizada.",
                    "El usuario debe ofrecer a los destinatarios un mecanismo claro y accesible de opt-out (baja/cancelación de mensajes) en todo momento.",
                    "El usuario asume responsabilidad legal por el cumplimiento de la Ley Federal de Protección de Datos Personales en Posesión de los Particulares (México), GDPR (si aplica) y demás normativas de privacidad aplicables.",
                    "El usuario indemnizará y mantendrá indemne a Agoramy frente a cualquier reclamación, sanción o daño derivado de mensajes enviados sin el consentimiento adecuado de los destinatarios.",
                    "Agoramy puede suspender preventivamente cuentas que reciban un número inusualmente alto de reportes de spam o quejas de destinatarios.",
                  ].map(item => (
                    <li class="flex items-start gap-3">
