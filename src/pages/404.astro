---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Página no encontrada | Agoramy">
  <section class="relative min-h-screen flex items-center justify-center bg-gradient-to-b from-white to-slate-50">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center px-4">
        <div class="mb-8">
          <img
            src="/erro404w.webp"
            alt="Error 404"
            class="w-full max-w-md mx-auto"
          />
        </div>

        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          Página no encontrada
        </h1>

        <p class="text-lg md:text-xl text-gray-600 mb-8 max-w-2xl mx-auto">
          Lo sentimos, la página que estás buscando no existe o ha sido movida.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-20">
          <a
            href="/"
            class="inline-flex items-center px-8 py-3 bg-green-500 text-white font-semibold rounded-lg hover:bg-green-600 hover:shadow-lg transition-all"
          >
            <i class="fas fa-home mr-2"></i>
            Volver al Inicio
          </a>

          <a
            href="/contact"
            class="inline-flex items-center px-8 py-3 bg-gray-100 text-gray-700 font-semibold rounded-lg hover:bg-gray-200 transition-all"
          >
            <i class="fas fa-envelope mr-2"></i>
            Contáctanos
          </a>
        </div>

        <!-- Separador adicional entre los botones y el footer -->
        <div class="h-32"></div>
      </div>
    </div>
  </section>
</Layout>
