---
import Layout from '../../layouts/Layout.astro';
import CountdownClock from '../../components/Common/CountdownClock.tsx';

---

<Layout title="Producto - Muy Pronto">
	<div class="text-gray-700">
		<!-- Hero Section with Coming Soon -->
		<section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-gradient-to-br from-gray-50 via-white to-gray-100">
			<!-- Subtle Animated Shapes -->
			<div class="absolute inset-0">
				<div class="absolute top-20 left-10 w-72 h-72 bg-green-500/5 rounded-full blur-3xl animate-pulse"></div>
				<div class="absolute bottom-20 right-10 w-96 h-96 bg-blue-500/5 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
				<div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-80 h-80 bg-teal-500/5 rounded-full blur-3xl animate-pulse" style="animation-delay: 2s;"></div>
			</div>

			<!-- Content -->
			<div class="container relative z-10">
				<div class="max-w-4xl mx-auto text-center px-4">
					<!-- Coming Soon Badge -->
					<div class="mb-8 inline-flex items-center gap-3 bg-green-50 border border-green-200 rounded-lg px-6 py-3" data-aos="fade-up">
						<div class="relative">
							<div class="w-2.5 h-2.5 bg-green-500 rounded-full animate-ping absolute"></div>
							<div class="w-2.5 h-2.5 bg-green-500 rounded-full"></div>
						</div>
						<span class="text-sm font-semibold text-green-700">Lanzamiento próximamente • 2025</span>
					</div>

					<!-- Main Title -->
					<h1 class="text-5xl md:text-6xl lg:text-7xl font-bold mt-6 mb-6 text-gray-900" data-aos="fade-up" data-aos-delay="100">
						Producto
					</h1>

					<!-- Subtitle -->
					<h2 class="text-3xl md:text-4xl font-semibold mb-8 text-gray-700" data-aos="fade-up" data-aos-delay="150">
						Muy Pronto
					</h2>
					<CountdownClock targetDate="2025-12-31T23:59:59" client:load />

					<!-- Description -->
					<p class="text-lg md:text-xl text-gray-600 mb-12 max-w-3xl mx-auto leading-relaxed" data-aos="fade-up" data-aos-delay="200">
						Estamos trabajando en algo extraordinario. Una solución innovadora que transformará la manera en que gestionas tu farmacia. Prepárate para una experiencia única que combina simplicidad, potencia y elegancia.
					</p>

					<!-- Features Preview -->
					<div class="grid md:grid-cols-3 gap-6 mb-12 max-w-4xl mx-auto" data-aos="fade-up" data-aos-delay="250">
						<div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-xl hover:border-green-300 transition-all duration-300 group">
							<div class="w-14 h-14 bg-green-50 rounded-xl flex items-center justify-center mb-4 mx-auto group-hover:bg-green-100 transition-colors">
								<svg class="w-7 h-7 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
								</svg>
							</div>
							<h3 class="text-xl font-bold mb-2 text-gray-900">Rendimiento Extremo</h3>
							<p class="text-gray-600 text-sm leading-relaxed">Velocidad y eficiencia sin precedentes para tu farmacia</p>
						</div>

						<div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-xl hover:border-blue-300 transition-all duration-300 group">
							<div class="w-14 h-14 bg-blue-50 rounded-xl flex items-center justify-center mb-4 mx-auto group-hover:bg-blue-100 transition-colors">
								<svg class="w-7 h-7 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
								</svg>
							</div>
							<h3 class="text-xl font-bold mb-2 text-gray-900">Seguridad Absoluta</h3>
							<p class="text-gray-600 text-sm leading-relaxed">Protección de datos de nivel empresarial garantizada</p>
						</div>

						<div class="bg-white border border-gray-200 rounded-2xl p-8 hover:shadow-xl hover:border-teal-300 transition-all duration-300 group">
							<div class="w-14 h-14 bg-teal-50 rounded-xl flex items-center justify-center mb-4 mx-auto group-hover:bg-teal-100 transition-colors">
								<svg class="w-7 h-7 text-teal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"></path>
								</svg>
							</div>
							<h3 class="text-xl font-bold mb-2 text-gray-900">Fácil de Usar</h3>
							<p class="text-gray-600 text-sm leading-relaxed">Interfaz intuitiva diseñada para farmacias</p>
						</div>
					</div>

					<!-- Subscription Form -->
					<div class="max-w-2xl mx-auto" data-aos="fade-up" data-aos-delay="300">
						<div class="bg-white border-2 border-gray-200 rounded-3xl p-8 md:p-10 shadow-xl">
							<h3 class="text-2xl md:text-3xl font-bold mb-3 text-gray-900">
								Sé el Primero en Saberlo
							</h3>
							<p class="text-gray-600 mb-8 text-base leading-relaxed">
								Regístrate para recibir una notificación cuando lancemos. Además, obtén acceso exclusivo anticipado y beneficios especiales.
							</p>
							<form class="flex flex-col sm:flex-row gap-4">
								<input
									type="email"
									placeholder="tu@email.com"
									class="flex-1 px-6 py-4 border-2 border-gray-300 rounded-xl text-gray-900 placeholder-gray-400 focus:outline-none focus:border-green-500 focus:ring-4 focus:ring-green-500/10 bg-white text-base transition-all"
									required
								/>
								<button
									type="submit"
									class="px-8 py-4 bg-green-500 text-white font-semibold rounded-xl hover:bg-green-600 hover:shadow-lg hover:shadow-green-500/30 transition-all duration-300 text-base"
								>
									Notifícame
								</button>
							</form>
							<p class="text-sm text-gray-500 mt-5 flex items-center justify-center gap-2">
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
								</svg>
								No spam. Solo actualizaciones importantes.
							</p>
						</div>
					</div>

					<!-- Disclaimer Section -->
					<div class="mt-16 max-w-3xl mx-auto text-center">
						<div class="bg-gray-50 border border-gray-200 rounded-xl p-6">
							<p class="text-sm text-gray-600 leading-relaxed">
								<svg class="w-5 h-5 text-gray-500 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
								</svg>
								<strong>Nota importante:</strong> Los meses gratis y ofertas especiales están limitados a un número específico de usuarios.
								Estas promociones pueden cambiar o finalizar en cualquier momento sin previo aviso.
							</p>
						</div>
					</div>
					<div class="h-20"></div>
				</div>
			</div>

			<!-- Floating Benefits Cards -->
			<div class="absolute bottom-10 left-10 hidden lg:block z-20" data-aos="fade-right" data-aos-delay="400">
				<div class="bg-white border-2 border-green-200 rounded-2xl p-5 shadow-2xl hover:shadow-[0_20px_50px_rgba(0,0,0,0.15)] transition-shadow">
					<div class="flex items-center gap-4">
						<div class="w-14 h-14 bg-green-50 rounded-xl flex items-center justify-center flex-shrink-0">
							<svg class="w-7 h-7 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
							</svg>
						</div>
						<div>
							<p class="font-bold text-gray-900 text-lg">2 Meses Gratis</p>
							<p class="text-sm text-gray-600">En fase Beta</p>
						</div>
					</div>
				</div>
			</div>

			<div class="absolute bottom-10 right-10 hidden lg:block z-20" data-aos="fade-left" data-aos-delay="400">
				<div class="bg-white border-2 border-blue-200 rounded-2xl p-5 shadow-2xl hover:shadow-[0_20px_50px_rgba(0,0,0,0.15)] transition-shadow">
					<div class="flex items-center gap-4">
						<div class="w-14 h-14 bg-blue-50 rounded-xl flex items-center justify-center flex-shrink-0">
							<svg class="w-7 h-7 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
							</svg>
						</div>
						<div>
							<p class="font-bold text-gray-900 text-lg">1000+</p>
							<p class="text-sm text-gray-600">En lista de espera</p>
						</div>
					</div>
				</div>
			</div>
		</section>
	</div>
</Layout>

<style>
	@keyframes pulse {
		0%, 100% {
			opacity: 0.6;
			transform: scale(1);
		}
		50% {
			opacity: 0.8;
			transform: scale(1.1);
		}
	}
</style>
