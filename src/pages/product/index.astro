---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/Common/PageHeader.astro';
import SubscriptionForm from '../../components/Product/SubscriptionForm.tsx';

// Condiciones con las que entraron los 1,000 negocios de la beta. Se dejan a la
// vista aunque el cupo esté lleno: sirven para decidir si vale la pena
// apuntarse a la lista.
const conditions = [
  'Cupo limitado a <strong class="text-gray-700">1,000 negocios</strong>, por orden de registro.',
  'Los <strong class="text-gray-700">consumibles se pagan aparte</strong>: timbres de facturación, correos y rutas de reparto.',
  'Un negocio dado de alta y operando de verdad, no una cuenta de prueba.',
  'Responder una encuesta corta al mes sobre lo que te está fallando.',
  'Al terminar los 6 meses pasas al plan que elijas. Sin cobro automático sorpresa.',
  'Puedes salirte cuando quieras y llevarte tus datos exportados.',
  'Cajas, empleados y productos extra siguen las tarifas del Plan Emprendedor.',
];
---

<Layout title="Producto - Agoramy">
  <div class="text-gray-800">
    <PageHeader
      eyebrow="Cupo lleno · lista con descuento abierta"
      title="Agoramy ya está funcionando. Y todavía lo estamos"
      highlight="puliendo"
      subtitle="El sistema está en operación en farmacias, ferreterías y tiendas en México. Los 1,000 lugares de esta ronda ya están ocupados. Abrimos una lista: quien se apunte ahora entra con descuento u otra oferta de lanzamiento cuando le toque lugar."
    >
      <div class="flex flex-wrap gap-3 justify-center mt-8">
        <span
          aria-disabled="true"
          class="bg-gray-200 text-gray-400 rounded-lg text-sm font-semibold px-6 py-3 cursor-not-allowed select-none"
        >
          Crear mi cuenta
        </span>
        <a
          href="/pricing"
          class="bg-green-500 text-white rounded-lg text-sm font-semibold px-6 py-3 hover:shadow-lg hover:shadow-green-500/30 focus:shadow-none focus:outline focus:outline-green-500/40 transition-all"
        >
          Ver precios
        </a>
      </div>
      <p class="text-sm text-gray-400 mt-4">
        El alta directa está cerrada: se agotaron los 1,000 lugares. Apúntate a la
        lista y guardas tu descuento.
      </p>
    </PageHeader>

    <section class="bg-gradient-to-r from-gray-100/70 to-gray-100 py-16 sm:py-24">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-3xl/tight font-medium mb-4">Qué incluyó la beta</h2>
          <p class="text-gray-500 max-w-xl mx-auto">
            Los 1,000 negocios de esta ronda entraron con seis meses sin costo a
            cambio de su retroalimentación. Estas fueron las condiciones, por si
            abrimos otra.
          </p>
        </div>

        <div class="max-w-3xl mx-auto mt-10">
          <div class="border border-gray-300 bg-white rounded p-8 sm:p-9">
            <div class="text-center">
              <p class="flex items-baseline justify-center gap-3">
                <span class="text-6xl font-bold text-green-500 leading-none">6</span>
                <span class="text-xl font-semibold text-gray-800">meses sin costo</span>
              </p>
              <p class="text-gray-500 mt-2">
                Plan de pruebas · todo lo del Plan Emprendedor incluido
              </p>
            </div>

            <div class="border-b border-gray-200 w-full my-7"></div>

            <p class="font-semibold text-gray-700 mb-4">Condiciones</p>
            <div class="grid sm:grid-cols-2 gap-x-8 gap-y-4">
              {conditions.map((condition) => (
                <div class="flex items-start gap-3">
                  <svg
                    class="stroke-green-500 stroke-2 w-4 h-4 flex-shrink-0 mt-1"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                  >
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <p class="text-sm text-gray-600 leading-relaxed" set:html={condition} />
                </div>
              ))}
            </div>

            <div class="mt-7 bg-gray-100 rounded-lg py-4 px-5">
              <p class="text-sm text-gray-600 leading-relaxed">
                <strong class="text-gray-700">Los 1,000 lugares ya se agotaron.</strong>{' '}
                Quien se apunte a la lista entra con descuento u otra oferta de
                lanzamiento cuando abramos lugar. Las condiciones de esa siguiente
                ronda pueden ser distintas a las de arriba.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 sm:py-24">
      <div class="container mx-auto px-4">
        <div class="max-w-xl mx-auto text-center">
          <h2 class="text-3xl/tight font-medium mb-4">
            Apúntate a la lista y guarda tu descuento
          </h2>
          <p class="text-gray-500 mb-8">
            Los 1,000 lugares de la beta ya se dieron. Quien se apunte ahora entra
            con un descuento u otra oferta de lanzamiento: te la confirmamos cuando
            te contactemos, uno por uno. Nada de spam.
          </p>

          <SubscriptionForm client:load />

          <p class="text-sm text-gray-400 mt-7">
            ¿Prefieres que te llamemos? Escríbenos desde{' '}
            <a href="/contact" class="text-green-500 hover:text-green-600">Contacto</a>{' '}
            y agendamos una demo de veinte minutos con el módulo de tu giro.
          </p>
        </div>
      </div>
    </section>
  </div>
</Layout>
