---
import Layout from '../../layouts/Layout.astro';
import CountdownClock from '../../components/Common/CountdownClock.tsx';
import SubscriptionForm from '../../components/Product/SubscriptionForm.tsx';
---

<Layout title="Producto — Agoramy POS">
  <!-- Hero -->
  <section class="pt-32 pb-20 bg-gradient-to-b from-gray-950 to-gray-900 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-16 left-1/3 w-80 h-80 bg-green-400 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-emerald-500 rounded-full blur-3xl"></div>
    </div>
    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 bg-green-500/10 border border-green-500/20 text-green-400 text-sm font-medium rounded-full mb-6">
          <span class="relative flex w-2.5 h-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full w-2.5 h-2.5 bg-green-500"></span>
          </span>
          Próximo Lanzamiento — Fase Beta
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
          El POS diseñado<br/>
          <span class="text-green-400">para farmacias</span>
        </h1>
        <p class="text-gray-400 text-lg leading-relaxed max-w-xl mx-auto mb-10">
          Agoramy POS llega pronto. Gestión de inventario, facturación CFDI 4.0, analítica en tiempo real y mucho más — todo en un solo sistema.
        </p>
        <CountdownClock targetDate="2026-08-31T23:59:59" client:load />
        <div class="flex flex-wrap justify-center gap-6 mt-10 text-sm text-gray-400">
          {[
            { icon: "✓", text: "4 meses gratis en beta" },
            { icon: "✓", text: "Cupos limitados" },
            { icon: "✓", text: "Sin tarjeta requerida" },
          ].map(item => (
            <span class="flex items-center gap-1.5">
              <span class="text-green-500 font-bold">{item.icon}</span>
              {item.text}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="text-sm font-medium py-1 px-3 rounded-full text-green-600 bg-green-50 border border-green-100">
          Funcionalidades
        </span>
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mt-4 mb-4">
          Todo lo que necesita tu farmacia
        </h2>
        <p class="text-gray-500 text-lg">
          Un sistema completo pensado para la operación diaria de farmacias en México.
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
        {[
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>`,
            title: "Facturación CFDI 4.0",
            desc: "Emite facturas electrónicas en cumplimiento con SAT. Timbrado automático, cancelaciones y complementos de pago.",
          },
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582 4-8 4m0 5c0 2.21 3.582 4 8 4s8-1.79 8-4"/>`,
            title: "Control de Inventario",
            desc: "Catálogo de hasta 12,000 productos con alertas de stock mínimo, caducidades y trazabilidad de lotes.",
          },
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>`,
            title: "Analítica en tiempo real",
            desc: "Dashboards de ventas, compras y rentabilidad. Informes exportables y análisis de IA mensual.",
          },
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>`,
            title: "Gestión de empleados",
            desc: "Hasta 100 empleados con roles, permisos y control de acceso por caja o área.",
          },
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>`,
            title: "IA para clientes",
            desc: "Mensajes automatizados vía WhatsApp para recordatorios, promociones y atención al cliente.",
          },
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>`,
            title: "Ofertas y descuentos",
            desc: "Módulo de promociones configurable: descuentos por volumen, combos, descuentos por cliente.",
          },
        ].map(f => (
          <div class="rounded-2xl border border-gray-200 p-7 hover:border-green-200 hover:shadow-lg transition-all">
            <div class="w-12 h-12 bg-green-500/10 rounded-xl flex items-center justify-center mb-5">
              <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={f.icon} />
            </div>
            <h3 class="font-bold text-gray-900 mb-2">{f.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Beta Offer + Form -->
  <section class="py-20 bg-gray-950">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto grid lg:grid-cols-2 gap-12 items-center">
        <!-- Left: offer details -->
        <div>
          <span class="inline-block text-sm font-medium py-1 px-3 rounded-full text-green-400 bg-green-500/10 border border-green-500/20 mb-6">
            Oferta de Lanzamiento
          </span>
          <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6 leading-tight">
            4 meses gratis.<br/>
            <span class="text-green-400">Sin restricciones.</span>
          </h2>
          <p class="text-gray-400 text-lg leading-relaxed mb-8">
            Los primeros usuarios registrados en la lista de espera acceden a Agoramy POS completamente gratis durante la fase beta — sin límites de funcionalidades.
          </p>
          <ul class="space-y-4">
            {[
              "Acceso completo a todas las funcionalidades",
              "Sin tarjeta de crédito requerida",
              "Soporte directo del equipo de desarrollo",
              "Tu feedback moldea el producto final",
              "Cupos limitados — primero en llegar, primero en entrar",
            ].map(item => (
              <li class="flex items-start gap-3 text-gray-300 text-sm">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
                {item}
              </li>
            ))}
          </ul>
          <div class="mt-8 flex gap-4">
            <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center flex-1">
              <p class="text-3xl font-extrabold text-green-400">4</p>
              <p class="text-gray-400 text-xs mt-1">Meses gratis</p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center flex-1">
              <p class="text-3xl font-extrabold text-white">1000+</p>
              <p class="text-gray-400 text-xs mt-1">En lista de espera</p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center flex-1">
              <p class="text-3xl font-extrabold text-white">0</p>
              <p class="text-gray-400 text-xs mt-1">Costos ocultos</p>
            </div>
          </div>
        </div>

        <!-- Right: form -->
        <div class="bg-white rounded-2xl p-8 md:p-10">
          <h3 class="text-2xl font-bold text-gray-900 mb-2">Únete a la lista de espera</h3>
          <p class="text-gray-500 text-sm mb-8 leading-relaxed">
            Regístrate ahora y sé de los primeros en acceder. Cupos limitados.
          </p>
          <SubscriptionForm client:load />
          <p class="text-xs text-gray-400 mt-5 flex items-center gap-2">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
            Sin spam. Solo actualizaciones del lanzamiento.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Plans teaser -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center">
        <span class="text-sm font-medium py-1 px-3 rounded-full text-green-600 bg-green-50 border border-green-100">
          Precios
        </span>
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mt-4 mb-4">
          Planes para todos los tamaños
        </h2>
        <p class="text-gray-500 text-lg mb-10">
          Desde farmacias pequeñas hasta cadenas. Sin permanencia mínima.
        </p>
        <div class="grid sm:grid-cols-3 gap-4 mb-10">
          {[
            { plan: "Básico", price: "$120", desc: "Hasta 3 cajas · 25 empleados" },
            { plan: "Emprendedor", price: "$250", desc: "Hasta 6 cajas · 50 empleados", popular: true },
            { plan: "Empresa", price: "$450", desc: "Hasta 12 cajas · 100 empleados" },
          ].map(p => (
            <div class={`rounded-2xl border p-6 text-center transition-all ${p.popular ? 'border-green-400 shadow-lg shadow-green-100' : 'border-gray-200 hover:border-green-200'}`}>
              {p.popular && <p class="text-xs font-bold text-green-600 mb-2 uppercase tracking-wide">Más popular</p>}
              <p class="font-bold text-gray-900 mb-1">{p.plan}</p>
              <p class="text-3xl font-extrabold text-gray-900 mb-1">{p.price}</p>
              <p class="text-xs text-gray-400">MXN / mes</p>
              <p class="text-xs text-gray-500 mt-3">{p.desc}</p>
            </div>
          ))}
        </div>
        <a href="/pricing" class="inline-flex items-center gap-2 py-3 px-8 bg-gray-900 text-white font-semibold rounded-xl hover:bg-gray-800 transition-all text-sm">
          Ver planes completos
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Bottom note -->
  <section class="py-10 bg-gray-50 border-t border-gray-100">
    <div class="container mx-auto px-4 max-w-2xl text-center">
      <p class="text-xs text-gray-500 leading-relaxed">
        Los meses gratis y beneficios de la fase beta están sujetos a disponibilidad de cupos. La oferta puede finalizar en cualquier momento sin previo aviso.
      </p>
    </div>
  </section>
</Layout>
