---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Blog/Hero.astro';
import BlogPost1 from '../../components/Blog/BlogPost1.astro';
import BlogPost2 from '../../components/Blog/BlogPost2.astro';
import SubscriptionForm from '../../components/Blog/SubscriptionForm.tsx';
import { post1, post2 } from '../../components/Blog/data';

// post1[0] va como destacado; el resto se lista una sola vez debajo
const featuredPost = post1[0];
const allPosts = [...post1, ...post2];
const restPosts = allPosts.slice(1);

// Las etiquetas salen de los artículos, no de una lista escrita a mano:
// así nunca hay un filtro que no devuelva nada.
const tags = [...new Set(allPosts.map((p) => p.tag.value))].sort((a, b) =>
	a.localeCompare(b, 'es')
);

const tagBase =
	'border rounded-md text-xs font-medium tracking-wider transition-all duration-150 hover:shadow-lg focus:shadow-lg py-2 px-3 cursor-pointer';
const tagIdle = 'border-gray-300 text-gray-700';
---

<Layout title="Blog - Agoramy">
	<div class="text-gray-700">
		<Hero />
		<section class="py-24">
			<div class="container mx-auto px-4">
				<div class="flex items-center gap-2 flex-wrap">
					<p>Etiquetas:</p>
					<div class="flex flex-wrap items-center gap-1" id="blog-tag-filter">
						<button type="button" data-tag="todos" class={`${tagBase} ${tagIdle}`}>
							Todos
						</button>
						{tags.map((tag) => (
							<button type="button" data-tag={tag} class={`${tagBase} ${tagIdle}`}>
								{tag}
							</button>
						))}
					</div>
				</div>

				<div
					id="blog-featured"
					class="grid lg:grid-cols-3 grid-cols-1 gap-10 items-center lg:py-16 py-14"
					data-aos="fade-up"
					data-aos-duration="300"
				>
					<BlogPost1 post={featuredPost} />

					<SubscriptionForm client:load />
				</div>

				<div
					id="blog-grid"
					class="grid lg:grid-cols-3 md:grid-cols-2 grid-cols-1 gap-x-6 gap-y-12 lg:py-16 py-14"
					data-aos="fade-up"
				>
					<div data-post-tag={featuredPost.tag.value} data-featured-card class="hidden">
						<BlogPost2 post={featuredPost} />
					</div>
					{restPosts.map((item) => (
						<div data-post-tag={item.tag.value}>
							<BlogPost2 post={item} />
						</div>
					))}
				</div>

				<p id="blog-empty" class="hidden text-center text-gray-500 py-10">
					Todavía no hay artículos con esa etiqueta.
				</p>
			</div>
		</section>
	</div>
</Layout>

<script>
	const filter = document.getElementById('blog-tag-filter');
	const featured = document.getElementById('blog-featured');
	const empty = document.getElementById('blog-empty');
	const cards = Array.from(
		document.querySelectorAll<HTMLElement>('#blog-grid [data-post-tag]')
	);
	const buttons = Array.from(
		filter?.querySelectorAll<HTMLButtonElement>('[data-tag]') ?? []
	);

	const ACTIVE = ['bg-green-500', 'text-white', 'border-green-500'];
	const IDLE = ['border-gray-300', 'text-gray-700'];

	const known = new Set(buttons.map((b) => b.dataset.tag));

	function apply(tag: string, pushUrl: boolean) {
		const isAll = tag === 'todos';
		let shown = 0;

		featured?.classList.toggle('hidden', !isAll);

		for (const card of cards) {
			// El destacado ya se ve completo arriba, así que en "Todos" no se repite.
			const matches = isAll
				? !card.hasAttribute('data-featured-card')
				: card.dataset.postTag === tag;
			card.classList.toggle('hidden', !matches);
			if (matches) shown++;
		}

		empty?.classList.toggle('hidden', shown > 0);

		for (const button of buttons) {
			const on = button.dataset.tag === tag;
			button.classList.toggle('bg-green-500', on);
			button.classList.remove(...(on ? IDLE : ACTIVE));
			button.classList.add(...(on ? ACTIVE : IDLE));
			button.setAttribute('aria-pressed', String(on));
		}

		if (pushUrl) {
			const url = isAll
				? window.location.pathname
				: `${window.location.pathname}?tag=${encodeURIComponent(tag)}`;
			window.history.replaceState({}, '', url);
		}
	}

	filter?.addEventListener('click', (event) => {
		const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-tag]');
		if (button?.dataset.tag) apply(button.dataset.tag, true);
	});

	// Permite compartir /blog?tag=Anuncio y que abra ya filtrado.
	const fromUrl = new URLSearchParams(window.location.search).get('tag');
	apply(fromUrl && known.has(fromUrl) ? fromUrl : 'todos', false);
</script>
