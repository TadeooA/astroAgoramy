---
import Layout from '../../layouts/Layout.astro';
import BlogPost2 from '../../components/Blog/BlogPost2.astro';
import { post1, post2, summary, tagClass, type Post } from '../../components/Blog/data';

export async function getStaticPaths() {
	const allPosts = [...post1, ...post2];

	return allPosts
		.filter(post => post.slug)
		.map(post => ({
			params: { slug: post.slug },
			props: { post },
		}));
}

interface Props {
	post: Post;
}

const { post } = Astro.props;

// Primero los del mismo tema; si no alcanzan, se completa con otros para no dejar huecos.
const others = [...post1, ...post2].filter(p => p.slug && p.slug !== post.slug);
const related = [
	...others.filter(p => p.tag.value === post.tag.value),
	...others.filter(p => p.tag.value !== post.tag.value),
].slice(0, 3);

const pageUrl = encodeURIComponent(Astro.url.href);
const shareLinks = [
	{ label: 'Facebook', icon: 'fab fa-facebook-f', href: `https://www.facebook.com/sharer/sharer.php?u=${pageUrl}` },
	{ label: 'Twitter', icon: 'fab fa-twitter', href: `https://twitter.com/intent/tweet?url=${pageUrl}&text=${encodeURIComponent(post.title)}` },
	{ label: 'WhatsApp', icon: 'fab fa-whatsapp', href: `https://api.whatsapp.com/send?text=${encodeURIComponent(`${post.title} ${Astro.url.href}`)}` },
	{ label: 'LinkedIn', icon: 'fab fa-linkedin-in', href: `https://www.linkedin.com/sharing/share-offsite/?url=${pageUrl}` },
];
---

<Layout title={`${post.title} - Blog Agoramy`} description={summary(post)} image={post.image}>
	<div class="text-gray-700">
		<article>
			<header class="bg-gradient-to-t from-slate-500/10 pt-8 pb-32 sm:pb-40">
				<div class="container mx-auto px-4">
					<div class="max-w-3xl mx-auto">
						<nav aria-label="Ruta de navegación" class="flex items-center text-sm text-gray-500 gap-2 mb-8">
							<a href="/" class="shrink-0 hover:text-primary transition-colors">Inicio</a>
							<i class="fas fa-chevron-right text-xs" aria-hidden="true"></i>
							<a href="/blog" class="shrink-0 hover:text-primary transition-colors">Blog</a>
							<i class="fas fa-chevron-right text-xs" aria-hidden="true"></i>
							<span class="min-w-0 truncate text-gray-700">{post.title}</span>
						</nav>

						<span class={`inline-block ${tagClass(post.tag.value)} font-medium rounded-md text-xs py-1 px-2 mb-4`}>
							{post.tag.value}
						</span>

						<h1 class="text-3xl/tight md:text-4xl/tight xl:text-5xl/tight font-semibold text-gray-800 text-pretty mb-6">
							{post.title}
						</h1>

						{post.postedBy && post.postedOn && (
							<div class="flex items-center gap-3">
								<img src={post.postedBy.avatar} alt="" class="h-10 w-10 rounded-md" />
								<div>
									<p class="text-sm font-medium text-gray-800">{post.postedBy.name}</p>
									<p class="text-xs text-gray-500">{post.postedOn.date} · {post.postedOn.time}</p>
								</div>
							</div>
						)}
					</div>
				</div>
			</header>

			<div class="container mx-auto px-4">
				<div class="max-w-3xl mx-auto -mt-24 sm:-mt-32">
					<img
						src={post.image}
						alt=""
						class="w-full aspect-video object-cover rounded-lg shadow-2xl bg-gray-100"
					/>
				</div>

				<div class="max-w-2xl mx-auto py-12">
					{post.description && (
						<p class="text-lg/8 text-gray-600 mb-8 pb-8 border-b border-gray-200">{summary(post)}</p>
					)}

					<div class="article-body text-base/8 text-gray-700" set:html={post.content} />

					<div class="mt-12 pt-8 border-t border-gray-200 flex flex-wrap items-center justify-between gap-6">
						<div>
							<h2 class="text-sm font-semibold text-gray-800 mb-3">Comparte este artículo</h2>
							<div class="flex flex-wrap gap-2">
								{shareLinks.map(link => (
									<a
										href={link.href}
										target="_blank"
										rel="noopener noreferrer"
										aria-label={`Compartir en ${link.label}`}
										class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white text-gray-700 text-sm font-medium px-3 py-2 hover:border-primary hover:text-primary transition-all"
									>
										<i class={link.icon} aria-hidden="true"></i>
										<span>{link.label}</span>
									</a>
								))}
							</div>
						</div>
						<a href="/blog" class="text-sm font-medium text-primary hover:text-primary-hover-hover">
							<i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i> Volver al blog
						</a>
					</div>
				</div>
			</div>
		</article>

		<section class="bg-gradient-to-r from-gray-100/70 to-gray-100 py-16">
			<div class="container mx-auto px-4">
				<h2 class="text-3xl/tight font-medium text-center text-gray-800 mb-10">Sigue leyendo</h2>
				<div class="grid lg:grid-cols-3 md:grid-cols-2 grid-cols-1 gap-6">
					{related.map(relatedPost => <BlogPost2 post={relatedPost} />)}
				</div>
			</div>
		</section>
	</div>
</Layout>

<style>
	/* El contenido llega como HTML desde data.ts: aquí se le da un solo ritmo de lectura. */
	.article-body :global(p),
	.article-body :global(ul),
	.article-body :global(ol) {
		margin-bottom: 1.25rem;
	}
	.article-body :global(h2) {
		margin-top: 2.5rem;
		margin-bottom: 0.75rem;
		font-size: 1.5rem;
		line-height: 1.3;
		font-weight: 600;
		color: var(--color-gray-800);
	}
	.article-body :global(h3) {
		margin-top: 1.75rem;
		margin-bottom: 0.5rem;
		font-size: 1.125rem;
		line-height: 1.4;
		font-weight: 600;
		color: var(--color-gray-800);
	}
	.article-body :global(li) {
		margin-bottom: 0.25rem;
	}
	.article-body :global(a) {
		color: var(--color-primary);
		text-decoration: underline;
	}
</style>
