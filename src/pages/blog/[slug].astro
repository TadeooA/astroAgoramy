---
import Layout from '../../layouts/Layout.astro';
import { post1, post2, type Post } from '../../components/Blog/data';

export async function getStaticPaths() {
	const allPosts = [...post1, ...post2];

	return allPosts
		.filter(post => post.slug)
		.map(post => ({
			params: { slug: post.slug },
			props: { post },
		}));
}

interface Props {
	post: Post;
}

const { post } = Astro.props;
---

<Layout title={`${post.title} - Blog Agoramy`}>
	<div class="text-gray-700">
		<!-- Hero Section -->
		<section class="pt-36 pb-16 relative bg-gradient-to-b from-gray-50 to-white">
			<div class="container mx-auto px-4">
				<div class="max-w-4xl mx-auto">
					<!-- Breadcrumb -->
					<div class="mb-6">
						<nav class="flex text-sm text-gray-500">
							<a href={import.meta.env.BASE_URL} class="hover:text-green-500 transition-colors">Inicio</a>
							<span class="mx-2">/</span>
							<a href={`${import.meta.env.BASE_URL}/blog`} class="hover:text-green-500 transition-colors">Blog</a>
							<span class="mx-2">/</span>
							<span class="text-gray-700">{post.title}</span>
						</nav>
					</div>

					<!-- Tag -->
					<div class="mb-4">
						<span class={`inline-block ${post.tag.variant || 'bg-green-500/10 text-green-500'} font-medium rounded-md text-sm py-2 px-4`}>
							{post.tag.value}
						</span>
					</div>

					<!-- Title -->
					<h1 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-6">
						{post.title}
					</h1>

					<!-- Meta Info -->
					{post.postedBy && post.postedOn && (
						<div class="flex items-center gap-4 mb-8">
							<img
								src={post.postedBy.avatar}
								class="h-12 w-12 rounded-full object-cover"
								alt={post.postedBy.name}
							/>
							<div>
								<p class="font-semibold text-gray-900">{post.postedBy.name}</p>
								<p class="text-sm text-gray-500">
									{post.postedOn.date} · {post.postedOn.time}
								</p>
							</div>
						</div>
					)}

					<!-- Featured Image -->
					<div class="mb-12">
						<img
							src={post.image}
							alt={post.title}
							class="w-full h-auto rounded-2xl shadow-xl object-cover"
						/>
					</div>
				</div>
			</div>
		</section>

		<!-- Content Section -->
		<section class="py-12">
			<div class="container mx-auto px-4">
				<div class="max-w-4xl mx-auto">
					<!-- Description -->
					{post.description && (
						<div class="text-xl text-gray-600 leading-relaxed mb-8 pb-8 border-b border-gray-200">
							{post.description}
						</div>
					)}

					<!-- Main Content -->
					<article class="prose prose-lg max-w-none">
						<div class="text-gray-700 leading-relaxed" set:html={post.content} />
					</article>

					<!-- Share Section -->
					<div class="mt-12 pt-8 border-t border-gray-200">
						<h3 class="text-lg font-semibold text-gray-900 mb-4">Comparte este artículo</h3>
						<div class="flex flex-wrap gap-3">
							<a href="#" class="inline-flex items-center px-6 py-3 bg-blue-500 text-black rounded-lg hover:bg-blue-600 transition-all hover:shadow-lg font-medium">
								<i class="fab fa-facebook-f mr-2"></i>
								<span>Facebook</span>
							</a>
							<a href="#" class="inline-flex items-center px-6 py-3 bg-sky-500 text-black rounded-lg hover:bg-sky-600 transition-all hover:shadow-lg font-medium">
								<i class="fab fa-twitter mr-2"></i>
								<span>Twitter</span>
							</a>
							<a href="#" class="inline-flex items-center px-6 py-3 bg-green-600 text-black rounded-lg hover:bg-green-700 transition-all hover:shadow-lg font-medium">
								<i class="fab fa-whatsapp mr-2"></i>
								<span>WhatsApp</span>
							</a>
						</div>
					</div>

					<!-- Back to Blog -->
					<div class="mt-12 text-center">
						<a
							href={`${import.meta.env.BASE_URL}/blog`}
							class="inline-flex items-center px-6 py-3 bg-green-500 text-white font-semibold rounded-lg hover:bg-green-600 hover:shadow-lg transition-all"
						>
							<i class="fas fa-arrow-left mr-2"></i>
							Volver al Blog
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- Related Posts Section (Optional) -->
		<section class="py-16 bg-gray-50">
			<div class="container mx-auto px-4">
				<div class="max-w-4xl mx-auto">
					<h2 class="text-3xl font-bold text-gray-900 mb-8">Artículos Relacionados</h2>
					<div class="grid md:grid-cols-2 gap-8">
						{[...post1, ...post2]
							.filter(p => p.slug && p.slug !== post.slug && p.tag.value === post.tag.value)
							.slice(0, 2)
							.map(relatedPost => (
								<a href={`/blog/${relatedPost.slug}`} class="group">
									<div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-shadow">
										<img
											src={relatedPost.image}
											alt={relatedPost.title}
											class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300"
										/>
										<div class="p-6">
											<span class={`inline-block ${relatedPost.tag.variant || 'bg-green-500/10 text-green-500'} font-medium rounded-md text-xs py-1 px-3 mb-3`}>
												{relatedPost.tag.value}
											</span>
											<h3 class="text-xl font-semibold text-gray-900 mb-2 group-hover:text-green-500 transition-colors">
												{relatedPost.title}
											</h3>
											<p class="text-gray-600 text-sm line-clamp-2">
												{relatedPost.description}
											</p>
										</div>
									</div>
								</a>
							))}
					</div>
				</div>
			</div>
		</section>
	</div>
</Layout>
