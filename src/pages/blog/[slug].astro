---
import Layout from '../../layouts/Layout.astro';
import { post1, post2, type Post } from '../../components/Blog/data';

export async function getStaticPaths() {
	const allPosts = [...post1, ...post2];

	return allPosts
		.filter(post => post.slug)
		.map(post => ({
			params: { slug: post.slug },
			props: { post },
		}));
}

interface Props {
	post: Post;
}

const { post } = Astro.props;
---

<Layout title={`${post.title} - Blog Agoramy`}>
	<div class="text-gray-700">
		<!-- Hero Section -->
		<section class="pt-32 pb-12 relative bg-gradient-to-b from-green-50/30 to-white">
			<div class="container mx-auto px-4">
				<div class="max-w-4xl mx-auto">
					<!-- Breadcrumb -->
					<div class="mb-8">
						<nav class="flex items-center text-sm text-gray-500 gap-2">
							<a href={import.meta.env.BASE_URL} class="hover:text-green-500 transition-colors">Inicio</a>
							<i class="fas fa-chevron-right text-xs"></i>
							<a href={`${import.meta.env.BASE_URL}/blog`} class="hover:text-green-500 transition-colors">Blog</a>
							<i class="fas fa-chevron-right text-xs"></i>
							<span class="text-gray-700 truncate">{post.title}</span>
						</nav>
					</div>

					<!-- Tag -->
					<div class="mb-6">
						<span class={`inline-block ${post.tag.variant || 'bg-green-500/10 text-green-600'} font-semibold rounded-full text-xs uppercase tracking-wide py-2 px-4`}>
							{post.tag.value}
						</span>
					</div>

					<!-- Title -->
					<h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 mb-8 leading-tight">
						{post.title}
					</h1>

					<!-- Meta Info -->
					{post.postedBy && post.postedOn && (
						<div class="flex items-center gap-4 mb-12 pb-8 border-b border-gray-200">
							<img
								src={post.postedBy.avatar}
								class="h-14 w-14 rounded-full object-cover ring-2 ring-green-100"
								alt={post.postedBy.name}
							/>
							<div>
								<p class="font-semibold text-gray-900 text-lg">{post.postedBy.name}</p>
								<div class="flex items-center gap-2 text-sm text-gray-500">
									<i class="far fa-calendar text-xs"></i>
									<span>{post.postedOn.date}</span>
									<span>·</span>
									<i class="far fa-clock text-xs"></i>
									<span>{post.postedOn.time}</span>
								</div>
							</div>
						</div>
					)}

					<!-- Featured Image -->
					<div class="mb-0 -mx-4 sm:mx-0">
						<img
							src={post.image}
							alt={post.title}
							class="w-full h-auto sm:rounded-2xl shadow-2xl object-cover"
						/>
					</div>
				</div>
			</div>
		</section>

		<!-- Content Section -->
		<section class="py-12 bg-white">
			<div class="container mx-auto px-4">
				<div class="max-w-3xl mx-auto">
					<!-- Description -->
					{post.description && (
						<div class="text-xl text-gray-600 leading-relaxed mb-10 pb-10 border-b-2 border-gray-100 font-light">
							{post.description}
						</div>
					)}

					<!-- Main Content -->
					<article class="prose prose-lg prose-green max-w-none">
						<div class="text-gray-700 leading-loose text-lg" set:html={post.content} />
					</article>

					<!-- Share Section -->
					<div class="mt-16 pt-10 border-t-2 border-gray-100">
						<h3 class="text-2xl font-bold text-gray-900 mb-6">Comparte este artículo</h3>
						<div class="flex flex-wrap gap-4">
							<a
								href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.href)}`}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center gap-2 px-5 py-2.5 border-2 border-blue-500 text-blue-500 rounded-lg hover:bg-blue-50 transition-all font-medium group"
							>
								<i class="fab fa-facebook-f text-lg group-hover:scale-110 transition-transform"></i>
								<span>Compartir</span>
							</a>
							<a
								href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(Astro.url.href)}&text=${encodeURIComponent(post.title)}`}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center gap-2 px-5 py-2.5 border-2 border-sky-500 text-sky-500 rounded-lg hover:bg-sky-50 transition-all font-medium group"
							>
								<i class="fab fa-twitter text-lg group-hover:scale-110 transition-transform"></i>
								<span>Twittear</span>
							</a>
							<a
								href={`https://api.whatsapp.com/send?text=${encodeURIComponent(post.title + ' ' + Astro.url.href)}`}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center gap-2 px-5 py-2.5 border-2 border-green-500 text-green-500 rounded-lg hover:bg-green-50 transition-all font-medium group"
							>
								<i class="fab fa-whatsapp text-lg group-hover:scale-110 transition-transform"></i>
								<span>WhatsApp</span>
							</a>
							<a
								href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center gap-2 px-5 py-2.5 border-2 border-blue-700 text-blue-700 rounded-lg hover:bg-blue-50 transition-all font-medium group"
							>
								<i class="fab fa-linkedin-in text-lg group-hover:scale-110 transition-transform"></i>
								<span>LinkedIn</span>
							</a>
						</div>
					</div>

					<!-- Back to Blog -->
					<div class="mt-12 text-center">
						<a
							href={`${import.meta.env.BASE_URL}/blog`}
							class="inline-flex items-center gap-2 px-6 py-3 bg-green-500 text-white font-semibold rounded-lg hover:bg-green-600 hover:shadow-lg hover:scale-105 transition-all"
						>
							<i class="fas fa-arrow-left"></i>
							<span>Volver al Blog</span>
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- Related Posts Section -->
		<section class="py-20 bg-gradient-to-b from-gray-50 to-white">
			<div class="container mx-auto px-4">
				<div class="max-w-4xl mx-auto">
					<div class="text-center mb-12">
						<h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-3">Artículos Relacionados</h2>
						<p class="text-gray-600">Continúa leyendo sobre temas similares</p>
					</div>
					<div class="grid md:grid-cols-2 gap-8">
						{[...post1, ...post2]
							.filter(p => p.slug && p.slug !== post.slug && p.tag.value === post.tag.value)
							.slice(0, 2)
							.map(relatedPost => (
								<a href={`${import.meta.env.BASE_URL}/blog/${relatedPost.slug}`} class="group block">
									<div class="bg-white rounded-2xl shadow-md overflow-hidden hover:shadow-2xl transition-all duration-300 border border-gray-100 hover:border-green-200">
										<div class="overflow-hidden">
											<img
												src={relatedPost.image}
												alt={relatedPost.title}
												class="w-full h-56 object-cover group-hover:scale-110 transition-transform duration-500"
											/>
										</div>
										<div class="p-6">
											<span class={`inline-block ${relatedPost.tag.variant || 'bg-green-500/10 text-green-600'} font-semibold rounded-full text-xs uppercase tracking-wide py-1.5 px-3 mb-3`}>
												{relatedPost.tag.value}
											</span>
											<h3 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-green-600 transition-colors leading-tight">
												{relatedPost.title}
											</h3>
											<p class="text-gray-600 text-sm line-clamp-3 leading-relaxed">
												{relatedPost.description}
											</p>
											<div class="mt-4 flex items-center text-green-600 font-medium text-sm group-hover:gap-2 transition-all">
												<span>Leer artículo</span>
												<i class="fas fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
											</div>
										</div>
									</div>
								</a>
							))}
					</div>
				</div>
			</div>
		</section>
	</div>
</Layout>
