---
// No imports needed, just HTML/CSS
---

<div class="container mx-auto px-4 relative">
  <div class="text-center">
    <span class="text-xs bg-green-500/10 text-green-500/90 rounded-full px-2 py-1">
      Planes
    </span>
    <h1 class="text-3xl/tight font-medium mb-4">Precios</h1>
    <p class="text-gray-500">
      Planes que se <span class="text-green-500">adaptan</span> a tu farmacia
    </p>
  </div>

  <div class="grid xl:grid-cols-3 md:grid-cols-2 grid-cols-1 gap-7 mt-14">
    <div data-aos="fade-up" data-aos-duration="500">
      <div class="transition-all duration-300 pointer-events-auto hover:shadow-[0_0_1.5rem_0_rgba(0,0,0,.12)] hover:-translate-y-1">
        <div class="border border-gray-300 bg-white rounded w-full h-full text-center p-5">
          <span class="text-lg text-green-500">Básico</span>
          <h1 class="text-3xl/tight font-semibold mt-3">
            <sup class="text-gray-500 text-sm font-normal">$</sup> 599
            <sub class="text-gray-500 text-sm font-normal">/mes</sub>
          </h1>
          <div class="border-b border-gray-200 w-full my-7"></div>
          <div>
            <div class="flex flex-col gap-4">
              <p class="flex items-center text-gray-600 gap-4">
                <i class="fa-solid fa-check text-green-500 text-lg"></i>
                1 sucursal / 1 caja
              </p>
              <p class="flex items-center text-gray-600 gap-4">
                <i class="fa-solid fa-check text-green-500 text-lg"></i>
                Hasta 5,000 productos
              </p>
              <p class="flex items-center text-gray-600 gap-4">
                <i class="fa-solid fa-check text-green-500 text-lg"></i>
                Control de inventario básico
              </p>
              <p class="flex items-center text-gray-600 gap-4">
                <i class="fa-solid fa-check text-green-500 text-lg"></i>
                Soporte por correo electrónico
              </p>
            </div>
            <div class="flex mt-[120px]">
              <a
                href="#"
                class="bg-green-500/10 text-green-500/90 w-full py-3 rounded-lg border border-transparent hover:border hover:border-green-500/20 transition-all duration-300"
              >
                Comenzar Ahora
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div data-aos="fade-up" data-aos-duration="700">
      <div class="transition-all duration-300 pointer-events-auto hover:shadow-[0_0_1.5rem_0_rgba(0,0,0,.12)] hover:-translate-y-1">
        <div class="border border-gray-300 bg-white rounded w-full h-full text-center p-5">
          <span class="text-lg text-green-500">Profesional</span>
          <h1 class="text-3xl/tight font-semibold mt-3">
            <sup class="text-gray-500 text-sm font-normal">$</sup> 1,299
            <sub class="text-gray-500 text-sm font-normal">/mes</sub>
          </h1>
          <div class="border-b border-gray-200 w-full my-7"></div>
          <div>
            <div class="flex flex-col gap-4">
              <p class="flex items-center text-gray-600 gap-4">
                <i class="fa-solid fa-check text-green-500 text-lg"></i>
                Hasta 3 sucursales / 5 cajas
              </p>
              <p class="flex items-center text-gray-600 gap-4">
                <i class="fa-solid fa-check text-green-500 text-lg"></i>
                Productos ilimitados
              </p>
              <p class="flex items-center text-gray-600 gap-4">
                <i class="fa-solid fa-check text-green-500 text-lg"></i>
                Facturación electrónica
              </p>
              <p class="flex items-center text-gray-600 gap-4">
                <i class="fa-solid fa-check text-green-500 text-lg"></i>
                Gestión de recetas médicas
              </p>
              <p class="flex items-center text-gray-600 gap-4">
                <i class="fa-solid fa-check text-green-500 text-lg"></i>
                Soporte prioritario
              </p>
            </div>
            <div class="flex mt-20">
              <a
                href="#"
                class="bg-green-500 text-white w-full py-3 rounded-lg border border-transparent hover:shadow-lg hover:shadow-green-500/30 focus:shadow-none focus:outline focus:outline-green-500/40 hover:border hover:border-green-500 transition-all duration-300"
              >
                Comenzar Ahora
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div data-aos="fade-up" data-aos-duration="900">
      <div class="transition-all duration-300 pointer-events-auto hover:shadow-[0_0_1.5rem_0_rgba(0,0,0,.12)] hover:-translate-y-1">
        <div class="border border-gray-300 bg-white rounded w-full h-full text-center p-5">
          <span class="text-lg text-green-500">Empresarial</span>
          <h1 class="text-3xl/tight font-semibold mt-3">
            <sup class="text-gray-500 text-sm font-normal">$</sup> 2,499
            <sub class="text-gray-500 text-sm font-normal">/mes</sub>
          </h1>
          <div class="border-b border-gray-200 w-full my-7"></div>
          <div>
            <div class="flex flex-col gap-4">
              <p class="flex items-center text-gray-600 gap-4">
                <i class="fa-solid fa-check text-green-500 text-lg"></i>
                Sucursales y cajas ilimitadas
              </p>
              <p class="flex items-center text-gray-600 gap-4">
                <i class="fa-solid fa-check text-green-500 text-lg"></i>
                Todo lo del plan Profesional
              </p>
              <p class="flex items-center text-gray-600 gap-4">
                <i class="fa-solid fa-check text-green-500 text-lg"></i>
                API para integraciones
              </p>
              <p class="flex items-center text-gray-600 gap-4">
                <i class="fa-solid fa-check text-green-500 text-lg"></i>
                Soporte 24/7 por teléfono
              </p>
              <p class="flex items-center text-gray-600 gap-4">
                <i class="fa-solid fa-check text-green-500 text-lg"></i>
                Capacitación personalizada
              </p>
            </div>
            <div class="flex mt-20">
              <a
                href="#"
                class="bg-green-500/10 text-green-500/90 w-full py-3 rounded-lg border border-transparent hover:border hover:border-green-500/20 transition-all duration-300"
              >
                Contactar Ventas
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
