---
import { plans } from './Pricing/plans';
---

<div class="container mx-auto px-4 relative">
  <div class="text-center">
    <span class="text-xs bg-green-500/10 text-green-500/90 rounded-full px-2 py-1">
      Planes
    </span>
    <h2 class="text-3xl/tight font-medium mb-4">Precios</h2>
    <p class="text-gray-500">
      Planes que se <span class="text-green-500">adaptan</span> a tu negocio
    </p>
    <p class="text-sm text-gray-500 mt-3">
      Sucursales adicionales y consumibles (timbres, correos, mensajes del bot, recetas con IA, guías y entregas) se cobran aparte. Los consumibles, solo por lo que uses.
      <a href="/pricing" class="text-green-500 hover:text-green-600">Ver consumibles</a>
    </p>
  </div>

  <div class="grid xl:grid-cols-4 md:grid-cols-2 grid-cols-1 gap-7 mt-14">
    {plans.map((plan, index) => (
      <div data-aos="fade-up" data-aos-duration={500 + index * 200}>
        <div class="h-full transition-all duration-300 pointer-events-auto hover:shadow-[0_0_1.5rem_0_rgba(0,0,0,.12)] hover:-translate-y-1">
          <div class="border border-gray-300 bg-white rounded overflow-hidden w-full h-full text-center flex flex-col">
            <img
              src={plan.image.src}
              width={plan.image.width}
              height={plan.image.height}
              alt={`Plan ${plan.name}, nivel ${plan.tier}: ${plan.tagline}`}
              loading="lazy"
              class="w-full h-auto"
            />
            <div class="p-5 flex flex-col flex-1">
              <span class={`text-lg font-semibold ${plan.accent}`}>Plan {plan.name}</span>
              <span class="text-xs uppercase tracking-widest text-gray-500 mt-1">{plan.tier}</span>
              {plan.price === null ? (
                <p class="text-3xl/tight font-semibold mt-3">A medida</p>
              ) : (
                <p class="text-3xl/tight font-semibold mt-3">
                  <sup class="text-gray-500 text-sm font-normal">$</sup> {plan.price}
                  <sub class="text-gray-500 text-sm font-normal"> MXN/mes</sub>
                </p>
              )}
              <div class="border-b border-gray-200 w-full my-7"></div>
              {plan.includes && <p class="text-xs text-gray-600 mb-3">{plan.includes}</p>}
              <div class="flex flex-col gap-3 text-sm">
                {plan.features.map((feature) => (
                  <p class="flex items-start text-gray-600 gap-3">
                    <i class="fa-solid fa-check text-green-500 text-base mt-0.5"></i>
                    <span class="text-left">{feature}</span>
                  </p>
                ))}
              </div>
              {plan.extras.length > 0 && (
                <>
                  <div class="border-t border-gray-200 w-full my-5"></div>
                  <div class="flex flex-col gap-2 text-xs text-gray-500">
                    <p class="font-semibold text-gray-700">Se cobra aparte:</p>
                    {plan.extras.map((extra) => <p>{extra}</p>)}
                  </div>
                </>
              )}
              <div class="flex mt-auto pt-6">
                <a
                  href={plan.cta.href}
                  class={plan.featured
                    ? 'bg-green-500 text-white w-full py-3 rounded-lg border border-transparent hover:shadow-lg hover:shadow-green-500/30 focus:shadow-none focus:outline focus:outline-green-500/40 hover:border hover:border-green-500 transition-all duration-300'
                    : 'bg-green-500/10 text-green-500/90 w-full py-3 rounded-lg border border-transparent hover:border hover:border-green-500/20 transition-all duration-300'}
                >
                  {plan.cta.label}
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>
