---
// Consumibles: lo que se descuenta de un monedero aparte de la cuota del plan.
//
// Solo se publican tarifas confirmadas: no usar cifras inventadas ni textos de
// relleno tipo [PRECIO POR TIMBRE]. Las guías varían por envío y no llevan monto.

type Consumable = {
  name: string;
  detail: string;
  price: string[];
  when: string;
};

const consumables: Consumable[] = [
  {
    name: 'Timbre CFDI suelto',
    detail: 'Factura electrónica',
    price: ['De $3.50 a $0.80 MXN por timbre, según plan y volumen'],
    when: 'Cada factura timbrada',
  },
  {
    name: 'Correos',
    detail: 'Correos a tus clientes, por paquete',
    price: [
      '100 correos: $30 MXN',
      '500 correos: $100 MXN',
      '1,500 correos: $250 MXN',
      '5,000 correos: $500 MXN',
      '15,000 correos: $1,000 MXN',
    ],
    when: 'Cada correo enviado',
  },
  {
    name: 'Análisis de receta con IA',
    detail: 'Lectura automática de la receta médica. Cuota mensual incluida según tu plan',
    price: ['$2.00 MXN por análisis'],
    when: 'Cada receta analizada',
  },
  {
    name: 'Bot de WhatsApp con IA',
    detail: 'Disponible desde el plan Nebula',
    price: ['$100 MXN por 500 mensajes'],
    when: 'Cada mensaje',
  },
  {
    name: 'Guías de paquetería',
    detail: 'Envíos con paqueterías externas',
    price: ['Costo del courier más margen, cargo fijo, comisión e IVA. Varía por envío'],
    when: 'Cada guía creada',
  },
  {
    name: 'Entregas de flota propia',
    detail: 'Rutas de reparto con tus repartidores',
    price: ['$1.00 MXN por ruta'],
    when: 'Cada ruta',
  },
];
---

<section class="py-16 sm:py-24">
  <div class="container mx-auto px-4">
    <div class="text-center max-w-2xl mx-auto">
      <span
        class="text-sm font-medium py-1 px-3 rounded-full text-primary bg-primary/10"
      >
        Consumibles
      </span>
      <h2 class="text-3xl/tight font-medium mt-3 mb-4">
        Lo que se cobra aparte del plan
      </h2>
      <p class="text-gray-500">
        Tu plan cubre el sistema. Algunas cosas cuestan dinero cada vez que se
        usan, así que van por separado y solo pagas lo que consumes.
      </p>
    </div>

    <div class="mt-12 overflow-x-auto">
      <table class="w-full min-w-[720px] border-collapse text-left">
        <thead>
          <tr class="border-b border-gray-300">
            <th class="text-sm font-semibold text-gray-700 pb-3 pe-6">Consumible</th>
            <th class="text-sm font-semibold text-gray-700 pb-3 pe-6">Costo</th>
            <th class="text-sm font-semibold text-gray-700 pb-3">Cuándo se descuenta</th>
          </tr>
        </thead>
        <tbody>
          {consumables.map((item) => (
            <tr class="border-b border-gray-200 align-top">
              <td class="py-5 pe-6">
                <p class="text-sm font-semibold text-gray-800">{item.name}</p>
                <p class="text-xs text-gray-500 mt-1">{item.detail}</p>
              </td>
              <td class="py-5 pe-6 text-sm text-gray-600">
                {item.price.map((line) => <p>{line}</p>)}
              </td>
              <td class="py-5 text-sm text-gray-600">{item.when}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="mt-10 grid md:grid-cols-2 gap-6">
      <div class="border border-gray-300 rounded bg-white p-6">
        <h3 class="text-lg font-semibold text-gray-800 mb-2">Cómo funciona el monedero</h3>
        <p class="text-sm text-gray-600 leading-relaxed">
          Cada consumible tiene su propio monedero. Unos se descuentan de un saldo
          en pesos y otros de créditos enteros. Primero se consume la cuota que ya
          trae tu plan; cuando se agota, empieza a descontarse del monedero.
        </p>
      </div>
      <div class="border border-gray-300 rounded bg-white p-6">
        <h3 class="text-lg font-semibold text-gray-800 mb-2">Sin sorpresas en la factura</h3>
        <p class="text-sm text-gray-600 leading-relaxed">
          Cada movimiento queda registrado con fecha, concepto y saldo restante, y
          lo puedes consultar desde el sistema cuando quieras. Si un monedero se
          queda sin saldo, te avisamos antes de que deje de funcionar.
        </p>
      </div>
    </div>
  </div>
</section>
