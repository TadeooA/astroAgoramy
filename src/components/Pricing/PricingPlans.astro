---
// Pricing Plans component
---

<section class="py-20">
  <div class="container">
    <div class="text-center max-w-2xl mx-auto">
      <span class="text-sm font-medium py-1 px-3 rounded-full text-primary bg-primary/10">
        Planes
      </span>
      <h2 class="md:text-3xl/tight text-3xl font-semibold my-4">
        Planes de Precios
      </h2>
      <p class="md:text-lg text-slate-500 leading-7">
        Precios que <span class="text-primary">funcionan</span> para todos.
      </p>
    </div>
    <div class="grid xl:grid-cols-3 lg:grid-cols-2 grid-cols-1 gap-6 items-center mt-16">
      <div>
        <div class="border p-6 text-center rounded hover:shadow-lg">
          <h4 class="text-lg text-primary">Plan Básico</h4>
          <h1 class="mt-3 mb-8">
            <sup class="align-super text-sm text-slate-500">$</sup>
            <span class="text-3xl font-semibold">120</span>
            <sub class="text-sm text-slate-500"> MXN/mes</sub>
          </h1>
          <hr />
          <div class="grid gap-y-3 mt-8 text-sm">
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-500 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span class="text-left">3 cajas</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-500 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span class="text-left">25 empleados</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-500 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span class="text-left">3,000 productos</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-500 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span class="text-left">Facturación</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-500 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span class="text-left">Analítica de datos básica</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-500 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span class="text-left">Trazabilidad de ventas y compras</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-500 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span class="text-left">Módulo de ofertas</span>
            </div>
          </div>
          <hr class="my-5" />
          <div class="text-xs text-left text-slate-500">
            <p class="font-semibold text-slate-700">Extras:</p>
            <p>Caja extra: $30/mes</p>
            <p>Empleado extra: $20/mes</p>
            <p>+2,000 productos: $60/mes</p>
          </div>
          <div class="mt-6">
            <a href="/product" class="py-3 px-6 flex items-center justify-center rounded hover:border hover:border-primary/50 text-primary bg-primary/10 transition-all duration-500">Comenzar Ahora</a>
          </div>
        </div>
      </div>
      <div>
        <div class="bg-gradient-to-b from-gray-900 to-gray-800 ring-1 ring-green-500/30 rounded-xl p-6 hover:shadow-[0_0_2.5rem_0_rgba(34,197,94,.2)] transition-all duration-300">
          <div class="text-center mb-1">
            <span class="text-xs font-medium bg-green-500/20 text-green-400 px-3 py-1 rounded-full">Popular</span>
          </div>
          <h4 class="text-lg text-green-400 text-center mt-3 font-medium">Plan Emprendedor</h4>
          <h1 class="mt-3 mb-8 text-center text-white">
            <sup class="align-super text-sm text-gray-400">$</sup>
            <span class="text-4xl font-bold">250</span>
            <sub class="text-sm text-gray-400"> MXN/mes</sub>
          </h1>
          <hr class="border-white/10" />
          <p class="text-xs text-gray-400 mt-4 mb-3">Incluye todo lo del Plan Básico más:</p>
          <div class="grid gap-y-3 text-sm">
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-400 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span class="text-left text-gray-300">6 cajas</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-400 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span class="text-left text-gray-300">50 empleados</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-400 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span class="text-left text-gray-300">6,000 productos</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-400 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span class="text-left text-gray-300">Catálogo digital</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-400 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span class="text-left text-gray-300">Gestión de ventas y envíos</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-400 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span class="text-left text-gray-300">100 mensajes de IA para clientes</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-400 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span class="text-left text-gray-300">3 análisis mensuales de datos</span>
            </div>
          </div>
          <hr class="my-5 border-white/10" />
          <div class="text-xs text-left text-gray-400">
            <p class="font-semibold text-gray-200">Extras:</p>
            <p>Caja extra: $20/mes</p>
            <p>+2,000 productos: $40/mes</p>
            <p>+200 mensajes de IA: $100/mes</p>
          </div>
          <div class="mt-6">
            <a href="/product" class="py-3 px-6 flex items-center justify-center rounded-lg bg-green-500 text-white hover:bg-green-400 hover:shadow-lg hover:shadow-green-500/40 transition-all duration-300">Comenzar Ahora</a>
          </div>
        </div>
      </div>
      <div>
        <div class="border p-6 rounded hover:shadow-lg">
          <h4 class="text-lg text-primary text-center">Plan Empresa</h4>
          <h1 class="mt-3 mb-8 text-center">
            <sup class="align-super text-sm text-slate-500">$</sup>
            <span class="text-3xl font-semibold">450</span>
            <sub class="text-sm text-slate-500"> MXN/mes</sub>
          </h1>
          <hr />
          <p class="text-xs text-slate-600 mt-4 mb-3">Incluye todo lo del Plan Emprendedor y Básico más:</p>
          <div class="grid gap-y-3 text-sm">
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-500 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span class="text-left">12 cajas</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-500 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span class="text-left">100 empleados</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-500 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span class="text-left">12,000 productos</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-500 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span class="text-left">400 mensajes de IA</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-500 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span class="text-left">8 análisis mensuales de IA avanzada</span>
            </div>
          </div>
          <hr class="my-5" />
          <div class="text-xs text-left text-slate-500">
            <p class="font-semibold text-slate-700">Extras:</p>
            <p>Caja extra: $15/mes</p>
            <p>Empleado extra: $10/mes</p>
            <p>+200 mensajes de IA: $50/mes</p>
          </div>
          <div class="mt-6">
            <a href="/product" class="py-3 px-6 flex items-center justify-center rounded hover:border hover:border-primary/50 text-primary bg-primary/10 transition-all duration-500">Contactar Ventas</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
