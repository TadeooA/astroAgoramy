---
// Pricing Plans component

const checkIcon = `<svg class="w-4 h-4 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>`;

const plans = [
  {
    name: "Básico",
    price: "120",
    desc: "Perfecto para farmacias pequeñas que inician su digitalización.",
    popular: false,
    features: [
      "3 cajas registradoras",
      "25 empleados",
      "3,000 productos en catálogo",
      "Facturación CFDI 4.0",
      "Analítica de datos básica",
      "Trazabilidad de ventas y compras",
      "Módulo de ofertas y descuentos",
    ],
    extras: [
      "Caja extra: $30/mes",
      "Empleado extra: $20/mes",
      "+2,000 productos: $60/mes",
    ],
    cta: "Comenzar Ahora",
    ctaLink: "/product",
  },
  {
    name: "Emprendedor",
    price: "250",
    desc: "El más popular. Ideal para farmacias en crecimiento con operación multi-área.",
    popular: true,
    features: [
      "Todo lo del Plan Básico",
      "6 cajas registradoras",
      "50 empleados",
      "6,000 productos en catálogo",
      "Catálogo digital para clientes",
      "Gestión de ventas y envíos",
      "100 mensajes de IA para clientes",
      "3 análisis mensuales de datos",
    ],
    extras: [
      "Caja extra: $20/mes",
      "+2,000 productos: $40/mes",
      "+200 mensajes de IA: $100/mes",
    ],
    cta: "Comenzar Ahora",
    ctaLink: "/product",
  },
  {
    name: "Empresa",
    price: "450",
    desc: "Para cadenas y farmacias de alto volumen que necesitan máxima capacidad.",
    popular: false,
    features: [
      "Todo lo de Emprendedor",
      "12 cajas registradoras",
      "100 empleados",
      "12,000 productos en catálogo",
      "400 mensajes de IA al mes",
      "8 análisis mensuales de IA avanzada",
      "Reportes personalizados",
    ],
    extras: [
      "Caja extra: $15/mes",
      "Empleado extra: $10/mes",
      "+200 mensajes de IA: $50/mes",
    ],
    cta: "Contactar Ventas",
    ctaLink: "/contact",
  },
];
---

<section class="py-20 bg-white" id="planes">
  <div class="container mx-auto px-4">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="text-sm font-medium py-1 px-3 rounded-full text-green-600 bg-green-50 border border-green-100">
        Planes
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mt-4 mb-4">
        Elige tu plan
      </h2>
      <p class="text-gray-500 text-lg">
        Precios en MXN. Facturación mensual. Sin permanencia mínima.
      </p>
    </div>

    <div class="grid xl:grid-cols-3 lg:grid-cols-2 grid-cols-1 gap-6 max-w-6xl mx-auto items-start">
      {plans.map(plan => (
        <div class={`relative rounded-2xl overflow-hidden border transition-all duration-300 ${
          plan.popular
            ? 'border-green-400 shadow-xl shadow-green-100 scale-[1.02]'
            : 'border-gray-200 hover:border-green-200 hover:shadow-lg'
        }`}>
          {plan.popular && (
            <div class="bg-green-500 text-white text-xs font-bold text-center py-2 tracking-wider uppercase">
              ⭐ Más popular
            </div>
          )}
          <div class={`p-7 ${plan.popular ? 'bg-white' : 'bg-white'}`}>
            <!-- Header -->
            <div class="mb-6">
              <h3 class="text-lg font-bold text-gray-900 mb-1">Plan {plan.name}</h3>
              <p class="text-gray-500 text-sm leading-relaxed">{plan.desc}</p>
            </div>

            <!-- Price -->
            <div class="mb-6 pb-6 border-b border-gray-100">
              <div class="flex items-baseline gap-1">
                <span class="text-sm text-gray-400 font-medium">$</span>
                <span class="text-5xl font-extrabold text-gray-900">{plan.price}</span>
                <span class="text-gray-400 text-sm ml-1">MXN / mes</span>
              </div>
            </div>

            <!-- Features -->
            <ul class="space-y-3 mb-6">
              {plan.features.map(f => (
                <li class="flex items-start gap-2.5 text-sm text-gray-600">
                  <svg class="w-4 h-4 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                  </svg>
                  {f}
                </li>
              ))}
            </ul>

            <!-- Extras -->
            <div class="bg-gray-50 rounded-xl p-4 mb-6">
              <p class="text-xs font-bold text-gray-700 mb-2 uppercase tracking-wide">Extras disponibles</p>
              {plan.extras.map(e => (
                <p class="text-xs text-gray-500 py-0.5">{e}</p>
              ))}
            </div>

            <!-- CTA -->
            <a
              href={plan.ctaLink}
              class={`w-full py-3.5 px-6 flex items-center justify-center rounded-xl font-semibold text-sm transition-all ${
                plan.popular
                  ? 'bg-green-500 text-white hover:bg-green-600 hover:shadow-lg hover:shadow-green-500/25'
                  : 'bg-gray-900 text-white hover:bg-gray-800'
              }`}
            >
              {plan.cta}
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Nota Beta -->
    <div class="mt-12 max-w-2xl mx-auto text-center">
      <div class="bg-green-50 border border-green-200 rounded-xl p-5">
        <p class="text-green-800 text-sm font-semibold mb-1">🎉 Oferta de lanzamiento — Fase Beta</p>
        <p class="text-green-700 text-sm">Los primeros usuarios tienen acceso gratuito por 2 meses sin restricciones. Cupos limitados.</p>
        <a href="/product" class="inline-block mt-3 text-green-600 text-sm font-semibold hover:underline">Registrarme en la lista de espera →</a>
      </div>
    </div>
  </div>
</section>
