---
import { plans } from './plans';
import overview from '../../assets/images/plans/planesw.webp';
---

<section class="py-20">
  <div class="container">
    <div class="text-center max-w-2xl mx-auto">
      <span class="text-sm font-medium py-1 px-3 rounded-full text-primary bg-primary/10">
        Planes
      </span>
      <h2 class="md:text-3xl/tight text-3xl font-semibold my-4">
        Planes de Precios
      </h2>
      <p class="md:text-lg text-slate-500 leading-7">
        Precios que <span class="text-primary">funcionan</span> para todos.
      </p>
    </div>

    <!-- En xl los cuatro paneles quedan alineados sobre sus columnas; en pantallas menores cada tarjeta lleva su póster. -->
    <img
      src={overview.src}
      width={overview.width}
      height={overview.height}
      alt="Los cuatro planes de Agoramy: Onyx, Nebula, Magnetar y Quasar"
      loading="lazy"
      class="hidden xl:block w-full h-auto rounded-xl mt-16"
    />

    <div class="grid xl:grid-cols-4 lg:grid-cols-2 grid-cols-1 gap-6 mt-16 xl:mt-6">
      {plans.map((plan) => {
        const dark = plan.featured;
        return (
          <div>
            <div
              class={dark
                ? 'h-full flex flex-col overflow-hidden bg-gradient-to-b from-gray-900 to-gray-800 ring-1 ring-accent-dark/30 rounded-xl hover:shadow-[0_0_2.5rem_0_rgba(215,221,232,.2)] transition-all duration-300'
                : 'h-full flex flex-col overflow-hidden border rounded hover:shadow-lg'}
            >
              <img
                src={plan.image.src}
                width={plan.image.width}
                height={plan.image.height}
                alt={`Plan ${plan.name}, nivel ${plan.tier}: ${plan.tagline}`}
                loading="lazy"
                class="xl:hidden w-full h-auto"
              />
              <div class="p-6 flex flex-col flex-1">
                {dark && (
                  <div class="text-center mb-3">
                    <span class="text-xs font-medium bg-accent-dark/20 text-accent-dark px-3 py-1 rounded-full">Popular</span>
                  </div>
                )}
                <h4 class={`text-lg font-semibold text-center ${dark ? 'text-violet-300' : plan.accent}`}>
                  Plan {plan.name}
                </h4>
                <p class={`text-xs uppercase tracking-widest text-center mt-1 ${dark ? 'text-gray-400' : 'text-slate-500'}`}>
                  {plan.tier}
                </p>
                {plan.price === null ? (
                  <p class="mt-3 mb-8 text-center">
                    <span class="text-3xl font-semibold">A medida</span>
                  </p>
                ) : (
                  <p class={`mt-3 mb-8 text-center ${dark ? 'text-white' : ''}`}>
                    <sup class={`align-super text-sm ${dark ? 'text-gray-400' : 'text-slate-500'}`}>$</sup>
                    <span class={dark ? 'text-4xl font-bold' : 'text-3xl font-semibold'}>{plan.price}</span>
                    <sub class={`text-sm ${dark ? 'text-gray-400' : 'text-slate-500'}`}> MXN/mes</sub>
                  </p>
                )}
                <hr class={dark ? 'border-white/10' : ''} />
                {plan.includes && (
                  <p class={`text-xs mt-4 ${dark ? 'text-gray-400' : 'text-slate-600'}`}>{plan.includes}</p>
                )}
                <div class="grid gap-y-3 mt-4 text-sm">
                  {plan.features.map((feature) => (
                    <div class="flex items-start gap-2">
                      <svg class={`w-5 h-5 flex-shrink-0 ${dark ? 'text-accent-dark' : 'text-primary'}`} xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                      <span class={`text-left ${dark ? 'text-gray-300' : ''}`}>{feature}</span>
                    </div>
                  ))}
                </div>
                {plan.extras.length > 0 && (
                  <>
                    <hr class={`my-5 ${dark ? 'border-white/10' : ''}`} />
                    <div class={`text-xs text-left ${dark ? 'text-gray-400' : 'text-slate-500'}`}>
                      <p class={`font-semibold ${dark ? 'text-gray-200' : 'text-slate-700'}`}>Se cobra aparte:</p>
                      {plan.extras.map((extra) => <p>{extra}</p>)}
                    </div>
                  </>
                )}
                <div class="mt-auto pt-6">
                  <a
                    href={plan.cta.href}
                    class={dark
                      ? 'py-3 px-6 flex items-center justify-center rounded-lg bg-accent-dark text-accent-dark-foreground hover:bg-white hover:shadow-lg hover:shadow-accent-dark/30 transition-all duration-300'
                      : 'py-3 px-6 flex items-center justify-center rounded hover:border hover:border-primary/50 text-primary bg-primary/10 transition-all duration-500'}
                  >
                    {plan.cta.label}
                  </a>
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
