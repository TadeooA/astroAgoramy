---
// Vacantes. Dejar el array vacío cuando no hay posiciones abiertas: la sección
// cambia sola al estado "sin vacantes", que pide el CV en vez de solo disculparse.

type Vacancy = {
  title: string;
  location: string;
  type: string;
  postedDate: string;
  /** Rango salarial o "A convenir". Es lo que decide si alguien aplica. */
  salary: string;
  applyLink: string;
};

const vacancies: Vacancy[] = [
  // {
  //   title: 'Soporte a comercios (turno matutino)',
  //   location: 'Guadalajara · híbrido',
  //   type: 'Tiempo completo',
  //   postedDate: 'Publicado hace 2 días',
  //   salary: '$14,000 – $18,000 MXN',
  //   applyLink: '#',
  // },
];
---

<section class="py-20 bg-gradient-to-r from-gray-100/70 to-gray-100">
  <div class="container mx-auto px-4">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="text-sm font-medium py-1 px-3 rounded-full text-green-500 bg-green-500/10">
        Puestos Vacantes
      </span>
      <h2 class="text-3xl/tight font-medium mt-3 mb-4">Oportunidades de carrera</h2>
      <p class="text-gray-500">
        {vacancies.length > 0
          ? 'Publicamos aquí cada posición abierta. Si ninguna encaja, escríbenos de todos modos.'
          : 'Publicamos aquí cada posición abierta. Si no hay ninguna, igual queremos saber de ti.'}
      </p>
    </div>

    {vacancies.length === 0 ? (
      <div class="max-w-3xl mx-auto">
        <div class="border border-gray-300 bg-white rounded p-10 sm:p-12 text-center">
          <div class="w-14 h-14 bg-gray-100 rounded-lg flex items-center justify-center mx-auto mb-5">
            <svg
              class="w-7 h-7 text-gray-400"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <rect x="2.5" y="7" width="19" height="13" rx="2"></rect>
              <path d="M8.5 7V5.5a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2V7"></path>
              <path d="M2.5 12.5h19"></path>
            </svg>
          </div>

          <h3 class="text-xl font-semibold text-gray-800 mb-3">
            Ahora mismo no hay vacantes abiertas
          </h3>

          <p class="text-gray-500 leading-relaxed max-w-lg mx-auto mb-7">
            Estamos creciendo, así que esto cambia seguido. Déjanos tu CV y te
            escribimos en cuanto abramos una posición que encaje con lo que haces.
          </p>

          <a
            href="mailto:contacto@agoramy.com?subject=CV%20para%20Agoramy"
            class="inline-block bg-green-500 text-white rounded-lg text-sm font-semibold px-7 py-3 hover:shadow-lg hover:shadow-green-500/30 focus:shadow-none focus:outline focus:outline-green-500/40 transition-all"
          >
            Enviar mi CV
          </a>

          <div class="mt-8 pt-6 border-t border-gray-200">
            <p class="text-sm text-gray-500">
              O escríbenos directo a{' '}
              <a
                href="mailto:contacto@agoramy.com"
                class="text-green-500 hover:text-green-600 font-semibold"
              >
                contacto@agoramy.com
              </a>{' '}
              con tu CV y una línea sobre en qué te gustaría trabajar.
            </p>
          </div>
        </div>
      </div>
    ) : (
      <div class="max-w-4xl mx-auto flex flex-col gap-4">
        {vacancies.map((vacancy) => (
          <div class="border border-gray-300 bg-white rounded p-6 sm:px-7 flex flex-col md:flex-row md:items-center gap-5 transition-all duration-300 hover:shadow-[0_0_1.5rem_0_rgba(0,0,0,.12)]">
            <div class="grow">
              <h3 class="text-lg font-semibold text-gray-800 mb-3">{vacancy.title}</h3>
              <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-gray-500">
                <span class="flex items-center gap-2">
                  <i class="fa-solid fa-location-dot text-gray-400"></i>
                  {vacancy.location}
                </span>
                <span class="flex items-center gap-2">
                  <i class="fa-solid fa-briefcase text-gray-400"></i>
                  {vacancy.type}
                </span>
                <span class="flex items-center gap-2">
                  <i class="fa-solid fa-clock text-gray-400"></i>
                  {vacancy.postedDate}
                </span>
                <span class="flex items-center gap-2 font-semibold text-gray-700">
                  <i class="fa-solid fa-money-bill-wave text-green-500"></i>
                  {vacancy.salary}
                </span>
              </div>
            </div>
            <a
              href={vacancy.applyLink}
              class="flex-none text-center bg-green-500 text-white rounded-lg text-sm font-semibold px-6 py-3 hover:shadow-lg hover:shadow-green-500/30 focus:shadow-none focus:outline focus:outline-green-500/40 transition-all"
            >
              Ver vacante
            </a>
          </div>
        ))}
      </div>
    )}
  </div>
</section>
