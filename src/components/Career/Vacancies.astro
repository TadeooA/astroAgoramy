---
// Vacancies component for Career page

// Array de vacantes - dejarlo vacío cuando no hay vacantes disponibles
const vacancies = [
  // Ejemplo de cómo agregar vacantes:
  // {
  //   title: 'Desarrollador Frontend Senior',
  //   location: 'Remoto',
  //   type: 'Tiempo completo',
  //   postedDate: 'Publicado hace 2 días',
  //   applyLink: '#'
  // }
];
---

<section class="py-20 bg-slate-100">
  <div class="container">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="text-sm font-medium py-1 px-3 rounded-full text-green-600 bg-green-100">
        Puestos Vacantes
      </span>
      <h2 class="md:text-3xl/tight text-3xl font-semibold my-4">
        Oportunidades de Carrera
      </h2>
      <p class="md:text-lg text-slate-500 leading-7">
        {vacancies.length > 0
          ? 'Explora nuestras ofertas de empleo actuales y encuentra tu próxima oportunidad profesional'
          : 'Conoce nuestras futuras oportunidades laborales'}
      </p>
    </div>

    {vacancies.length === 0 ? (
      <!-- Mensaje cuando no hay vacantes -->
      <div class="max-w-3xl mx-auto">
        <div class="bg-white rounded-2xl p-12 text-center">
          <div class="w-20 h-20 bg-gray-100 rounded-lg flex items-center justify-center mx-auto mb-6">
            <svg
              class="w-10 h-10 text-gray-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              />
            </svg>
          </div>

          <h3 class="text-2xl font-bold text-gray-900 mb-4">
            No hay vacantes disponibles por el momento
          </h3>

          <p class="text-lg text-gray-600 mb-6 leading-relaxed">
            Actualmente no tenemos posiciones abiertas, pero estamos en constante crecimiento.
            Te invitamos a regresar pronto para conocer nuevas oportunidades laborales en Agoramy.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mt-8">
            <a
              href={`${import.meta.env.BASE_URL}/contact`}
              class="inline-flex items-center px-6 py-3 bg-green-500 text-white font-semibold rounded-lg hover:bg-green-600 transition-colors"
            >
              <i class="fas fa-envelope mr-2"></i>
              Contáctanos
            </a>
            <a
              href={import.meta.env.BASE_URL}
              class="inline-flex items-center px-6 py-3 bg-gray-100 text-gray-700 font-semibold rounded-lg hover:bg-gray-200 transition-colors"
            >
              <i class="fas fa-home mr-2"></i>
              Volver al Inicio
            </a>
          </div>

          <div class="mt-8 pt-8 border-t border-gray-200">
            <p class="text-sm text-gray-500">
              ¿Interesado en trabajar con nosotros? Envíanos tu CV a
              <a href="mailto:contacto@agoramy.com" class="text-green-500 hover:text-green-600 font-semibold">
                contacto@agoramy.com
              </a>
            </p>
          </div>
        </div>
      </div>
    ) : (
      <!-- Lista de vacantes cuando hay disponibles -->
      <div class="space-y-4">
        {vacancies.map((vacancy) => (
          <div class="bg-white p-6 rounded-lg shadow-sm hover:shadow-md transition-shadow">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
              <div>
                <h4 class="text-xl font-semibold mb-2">{vacancy.title}</h4>
                <div class="flex flex-wrap gap-4 text-sm text-gray-600">
                  <span><i class="fa-solid fa-location-dot mr-2"></i>{vacancy.location}</span>
                  <span><i class="fa-solid fa-briefcase mr-2"></i>{vacancy.type}</span>
                  <span><i class="fa-solid fa-clock mr-2"></i>{vacancy.postedDate}</span>
                </div>
              </div>
              <a
                href={vacancy.applyLink}
                class="py-2 px-6 bg-green-500 text-white rounded-lg hover:bg-green-600 hover:shadow-lg transition-all font-semibold"
              >
                Aplicar Ahora
              </a>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</section>
