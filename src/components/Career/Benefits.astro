---
// Benefits component for Career page
---

<section class="py-20 bg-white">
  <div class="container mx-auto px-4">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="text-sm font-medium py-1 px-3 rounded-full text-green-600 bg-green-50 border border-green-100">
        Beneficios
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mt-4 mb-4">
        ¿Por qué trabajar en Agoramy?
      </h2>
      <p class="text-gray-500 text-lg leading-relaxed">
        Somos una startup en crecimiento que valora a las personas que la construyen.
      </p>
    </div>
    <div class="grid lg:grid-cols-3 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
      {[
        { icon: "🏠", title: "Trabajo 100% Remoto", desc: "Trabaja desde donde seas más productivo. Sin oficina obligatoria, sin traslados." },
        { icon: "⏰", title: "Horario Flexible", desc: "Gestiona tu tiempo. Lo que importa son los resultados, no el horario rígido." },
        { icon: "📚", title: "Aprendizaje Continuo", desc: "Budget para cursos, libros y conferencias. Crecer es parte del trabajo." },
        { icon: "🚀", title: "Impacto Real", desc: "Tu código llega directamente a farmacias y negocios mexicanos desde el primer día." },
        { icon: "🤝", title: "Equipo Apasionado", desc: "Trabajarás con personas que de verdad disfrutan lo que construyen." },
        { icon: "📈", title: "Crecimiento Profesional", desc: "Startup en expansión = oportunidades reales de asumir más responsabilidad y crecer con la empresa." },
      ].map(b => (
        <div class="p-6 border border-gray-100 rounded-2xl hover:border-green-200 hover:shadow-md transition-all group">
          <div class="w-12 h-12 bg-gray-50 rounded-xl flex items-center justify-center text-2xl mb-4 group-hover:bg-green-50 transition-colors">
            {b.icon}
          </div>
          <h5 class="text-base font-bold text-gray-900 mb-2">{b.title}</h5>
          <p class="text-gray-500 text-sm leading-relaxed">{b.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
