---
// Benefits component for Career page
---

<section class="py-20 bg-slate-100">
  <div class="container">
    <div class="text-center max-w-2xl mx-auto">
      <span class="text-sm font-medium py-1 px-3 rounded-full text-primary bg-primary/10">
        Beneficios
      </span>
      <h2 class="md:text-3xl/tight text-3xl font-semibold my-4">
        ¿Por qué trabajar con nosotros?
      </h2>
      <p class="md:text-lg text-slate-500 leading-7">
        Ofrecemos grandes beneficios y un excelente ambiente de trabajo
      </p>
    </div>
    <div class="grid lg:grid-cols-3 md:grid-cols-2 grid-cols-1 gap-6 mt-16">
      <div class="bg-white p-6 rounded-lg shadow-sm">
        <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
          <i class="fa-solid fa-heart text-primary text-xl"></i>
        </div>
        <h5 class="text-lg font-semibold mb-2">Seguro de Salud</h5>
        <p class="text-gray-600">Cobertura de salud completa para ti y tu familia</p>
      </div>
      <div class="bg-white p-6 rounded-lg shadow-sm">
        <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
          <i class="fa-solid fa-plane text-primary text-xl"></i>
        </div>
        <h5 class="text-lg font-semibold mb-2">Tiempo Libre Flexible</h5>
        <p class="text-gray-600">Tómate tiempo cuando lo necesites con vacaciones ilimitadas</p>
      </div>
      <div class="bg-white p-6 rounded-lg shadow-sm">
        <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
          <i class="fa-solid fa-home text-primary text-xl"></i>
        </div>
        <h5 class="text-lg font-semibold mb-2">Trabajo Remoto</h5>
        <p class="text-gray-600">Trabaja desde cualquier parte del mundo</p>
      </div>
      <div class="bg-white p-6 rounded-lg shadow-sm">
        <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
          <i class="fa-solid fa-graduation-cap text-primary text-xl"></i>
        </div>
        <h5 class="text-lg font-semibold mb-2">Presupuesto de Aprendizaje</h5>
        <p class="text-gray-600">Presupuesto anual para desarrollo profesional</p>
      </div>
      <div class="bg-white p-6 rounded-lg shadow-sm">
        <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
          <i class="fa-solid fa-users text-primary text-xl"></i>
        </div>
        <h5 class="text-lg font-semibold mb-2">Gran Equipo</h5>
        <p class="text-gray-600">Trabaja con personas talentosas y apasionadas</p>
      </div>
      <div class="bg-white p-6 rounded-lg shadow-sm">
        <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
          <i class="fa-solid fa-chart-line text-primary text-xl"></i>
        </div>
        <h5 class="text-lg font-semibold mb-2">Crecimiento Profesional</h5>
        <p class="text-gray-600">Camino claro para el avance y crecimiento profesional</p>
      </div>
    </div>
  </div>
</section>
