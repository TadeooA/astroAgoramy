---
// About component for Company page - Quiénes Somos
import farmacia from '../../assets/images/hero/farmaciaw.webp';
import ferreteria from '../../assets/images/hero/ferreteriaw.webp';
import tienda from '../../assets/images/hero/tiendaw.webp';
import equipoInventario from '../../assets/images/blog/inventarioBlogw.webp';
import crecimiento from '../../assets/images/blog/lanzamientoBlogw.webp';

const giros = [
  { image: farmacia, label: 'Farmacia' },
  { image: ferreteria, label: 'Ferretería' },
  { image: tienda, label: 'Tienda' },
];
---

<section class="pt-6 sm:pt-8 pb-16 sm:pb-24 bg-white" id="quienes-somos">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Columna de Imagen -->
      <div class="order-2 lg:order-1" data-aos="fade-right">
        <div class="grid grid-cols-2 gap-3">
          {giros.map((giro, index) => (
            <figure class={`relative overflow-hidden rounded-lg shadow-2xl ${index === 0 ? 'col-span-2' : ''}`}>
              <img
                src={giro.image.src}
                width={giro.image.width}
                height={giro.image.height}
                alt={`Fachada de una ${giro.label.toLowerCase()} con el logo de Agoramy`}
                class="w-full h-auto"
              />
              <figcaption class="absolute bottom-2 start-2 rounded bg-white/90 px-2 py-1 text-xs font-semibold text-gray-800">
                {giro.label}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>

      <!-- Columna de Contenido -->
      <div class="order-1 lg:order-2" data-aos="fade-left">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-6">
          Transformando la gestión
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-primary-hover">
            de los negocios de mostrador en México
          </span>
        </h2>

        <p class="text-lg text-gray-600 mb-6 leading-relaxed">
          Agoramy nació para simplificar y modernizar la gestión de las farmacias en México. Hoy es un solo sistema POS para farmacias, ferreterías y tiendas, adaptado a lo que necesita cada giro: control de recetas y caducidades, venta a granel y cotizaciones, o cobro rápido y promociones.
        </p>

        <p class="text-lg text-gray-600 mb-8 leading-relaxed">
          Somos un equipo apasionado de profesionales dedicado a crear soluciones tecnológicas innovadoras que empoderen a cada negocio para alcanzar su máximo potencial, sea cual sea su giro. Creemos en la innovación constante y en construir relaciones duraderas con nuestros clientes.
        </p>

        <!-- Valores o características -->
        <div class="grid sm:grid-cols-2 gap-6">
          <div class="flex items-start space-x-4">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center">
                <i class="fas fa-lightbulb text-primary text-xl"></i>
              </div>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">Innovación</h3>
              <p class="text-gray-600 text-sm">Tecnología de vanguardia para tu negocio</p>
            </div>
          </div>

          <div class="flex items-start space-x-4">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 bg-rose-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-users text-rose-600 text-xl"></i>
              </div>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">Colaboración</h3>
              <p class="text-gray-600 text-sm">Trabajamos junto a ti para tu éxito</p>
            </div>
          </div>

          <div class="flex items-start space-x-4">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-chart-line text-purple-600 text-xl"></i>
              </div>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">Resultados</h3>
              <p class="text-gray-600 text-sm">Enfocados en el crecimiento de tu negocio</p>
            </div>
          </div>

          <div class="flex items-start space-x-4">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-shield-alt text-orange-600 text-xl"></i>
              </div>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">Confianza</h3>
              <p class="text-gray-600 text-sm">Seguridad y transparencia en todo momento</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Sección de Misión -->
<section class="py-16 sm:py-24 bg-gray-50">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Columna de Contenido -->
      <div class="order-1" data-aos="fade-right">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-6">
          Proporcionar soluciones
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-primary-hover">
            POS innovadoras
          </span>
        </h2>

        <p class="text-lg text-gray-600 leading-relaxed">
          Proporcionar soluciones POS innovadoras y adaptadas a cada giro que empoderen a las farmacias, ferreterías y tiendas mexicanas para alcanzar sus objetivos, mejorando su eficiencia operativa y transformando digitalmente sus procesos con herramientas modernas, intuitivas y accesibles.
        </p>
      </div>

      <!-- Columna de Imagen -->
      <div class="order-2" data-aos="fade-left">
        <div class="relative">
          <img
            src={equipoInventario.src}
            width={equipoInventario.width}
            height={equipoInventario.height}
            alt="Dos personas revisan el inventario de su negocio con una tablet"
            loading="lazy"
            class="rounded-lg shadow-2xl w-full h-auto object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Sección de Visión -->
<section class="py-16 sm:py-24 bg-white">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Columna de Imagen -->
      <div class="order-2 lg:order-1" data-aos="fade-right">
        <div class="relative">
          <img
            src={crecimiento.src}
            width={crecimiento.width}
            height={crecimiento.height}
            alt="Cohete despegando junto al logo de Agoramy"
            loading="lazy"
            class="rounded-lg shadow-2xl w-full h-auto object-cover"
          />
        </div>
      </div>

      <!-- Columna de Contenido -->
      <div class="order-1 lg:order-2" data-aos="fade-left">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-6">
          Ser el sistema POS
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-primary-hover">
            líder en México
          </span>
        </h2>

        <p class="text-lg text-gray-600 leading-relaxed">
          Ser el sistema POS líder y más confiable para los negocios de mostrador en México, reconocidos por nuestra innovación tecnológica, facilidad de uso y compromiso con el éxito de nuestros clientes en toda la República Mexicana.
        </p>
      </div>
    </div>
  </div>
</section>
