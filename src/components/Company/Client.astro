---
// images
import amazon from '../../assets/images/brands/amazon.svg';
import google from '../../assets/images/brands/google.svg';
import paypal from '../../assets/images/brands/paypal.svg';
import shopify from '../../assets/images/brands/shopify.svg';

const brands = [amazon, google, paypal, shopify];
---

<section class="lg:pb-20 py-16">
  <div class="container">
    <div class="text-center">
      <span class="text-sm bg-primary/10 text-primary rounded-full px-3 py-1">
        Inversores
      </span>
      <h1 class="text-3xl/tight font-medium mt-3 mb-4">
        Estamos respaldados por
      </h1>
      <p class="text-gray-500">
        Más de 100 clientes confían en<span class="text-primary"> Agoramy </span>para
        impulsar el rendimiento y el compromiso.
      </p>
    </div>
    <div class="mt-14">
      <div
        class="grid md:grid-cols-4 grid-cols-2 gap-5 items-center"
        data-aos="fade-up"
      >
        {brands.map((brand) => (
          <div>
            <img src={brand.src} alt="brand-logo" class="w-32 mx-auto" />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
