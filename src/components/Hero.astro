---
import SwiperSlider from './SwiperSlider.tsx';

// images
import sass1 from '../assets/images/hero/saas1.jpg';
import sass2 from '../assets/images/hero/saas2.jpg';
import sass3 from '../assets/images/hero/saas3.jpg';
import whiteWave from '../assets/images/shapes/white-wave.svg';

const images = [
  { src: sass1.src, alt: 'saas1' },
  { src: sass2.src, alt: 'saas2' },
  { src: sass3.src, alt: 'saas3' },
];
---

<div>
  <section class="bg-gradient-to-t from-slate-500/10 relative">
    <section class="relative pt-6 md:pt-8 lg:pt-10 pb-16 md:pb-20 lg:pb-24">
      <div class="container mx-auto px-4">
        <div class="grid lg:grid-cols-2 grid-cols-1 gap-8 md:gap-12 items-center">
          <div class="order-2 lg:order-1">
            <div class="text-center sm:text-start">
              <h1 class="text-3xl/tight sm:text-3xl/tight md:text-4xl/tight lg:text-4xl/tight xl:text-5xl/tight font-semibold mb-5 md:mb-6">
                El sistema POS más
                <span class="relative z-0 after:bg-green-500/50 after:-z-10 after:absolute md:after:h-6 after:h-4 after:w-full after:bottom-0 after:end-0">
                  completo
                </span>
                para tu farmacia
              </h1>
              <p class="text-base md:text-lg text-gray-500 mb-6 md:mb-8">
                Agoramy es el sistema POS moderno diseñado específicamente para farmacias en México. Gestiona tu negocio de forma eficiente y profesional.
              </p>
              <div class="flex gap-3 justify-center sm:justify-start mb-6">
                <a href={`${import.meta.env.BASE_URL}/product`} class="bg-green-500 text-white rounded-lg text-sm font-semibold flex-none hover:shadow-lg hover:shadow-green-500/30 focus:shadow-none focus:outline focus:outline-green-500/40 px-6 py-3">
                  Comenzar
                </a>
              </div>
              <div class="grid sm:grid-cols-2 gap-3">
                <div class="flex items-start gap-3">
                  <svg
                    class="stroke-green-500 stroke-2 w-5 h-5 flex-shrink-0 mt-0.5"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                  >
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <p class="text-sm text-gray-700">Control de inventario en tiempo real</p>
                </div>
                <div class="flex items-start gap-3">
                  <svg
                    class="stroke-green-500 stroke-2 w-5 h-5 flex-shrink-0 mt-0.5"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                  >
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <p class="text-sm text-gray-700">Facturación electrónica automática</p>
                </div>
                <div class="flex items-start gap-3">
                  <svg
                    class="stroke-green-500 stroke-2 w-5 h-5 flex-shrink-0 mt-0.5"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                  >
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <p class="text-sm text-gray-700">Alertas de caducidad de productos</p>
                </div>
                <div class="flex items-start gap-3">
                  <svg
                    class="stroke-green-500 stroke-2 w-5 h-5 flex-shrink-0 mt-0.5"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                  >
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <p class="text-sm text-gray-700">Reportes de ventas detallados</p>
                </div>
                <div class="flex items-start gap-3">
                  <svg
                    class="stroke-green-500 stroke-2 w-5 h-5 flex-shrink-0 mt-0.5"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                  >
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <p class="text-sm text-gray-700">Gestión de múltiples sucursales</p>
                </div>
                <div class="flex items-start gap-3">
                  <svg
                    class="stroke-green-500 stroke-2 w-5 h-5 flex-shrink-0 mt-0.5"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                  >
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <p class="text-sm text-gray-700">Control de recetas médicas</p>
                </div>
              </div>
            </div>
          </div>

          <div class="order-1 lg:order-2">
            <div class="relative">
              <div class="hidden sm:block">
                <div class="before:w-24 before:h-24 before:absolute before:-bottom-8 before:-start-8 before:bg-[url('/src/assets/images/pattern/dot2.svg')]"></div>
                <div class="after:w-24 after:h-24 after:absolute after:-top-10 after:end-10 2xl:after:end-0 after:rotate-45 after:bg-[url('/src/assets/images/pattern/dot5.svg')]"></div>
              </div>

              <div
                id="swiper_one"
                data-aos="fade-left"
                data-aos-duration="1000"
              >
                <SwiperSlider images={images} client:load />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="absolute bottom-0 inset-x-0 hidden sm:block">
      <img
        src={whiteWave.src}
        alt="white-wave-svg"
        class="w-full -scale-x-100 -scale-y-100"
      />
    </div>
  </section>
</div>
