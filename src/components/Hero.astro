---
import SwiperSlider from './SwiperSlider.tsx';

// images
import heroFarmacia from '../assets/images/hero/farmaciaw.webp';
import heroFerreteria from '../assets/images/hero/ferreteriaw.webp';
import heroTienda from '../assets/images/hero/tiendaw.webp';
import whiteWave from '../assets/images/shapes/white-wave.svg';
import dot2 from '../assets/images/pattern/dot2.svg';
import dot5 from '../assets/images/pattern/dot5.svg';

const dot2Style = `--dot2: url(${dot2.src})`;
const dot5Style = `--dot5: url(${dot5.src})`;

const images = [
  { src: heroFarmacia.src, alt: 'Fachada de una farmacia con el logo de Agoramy', type: 'image' as const },
  { src: heroFerreteria.src, alt: 'Fachada de una ferretería con el logo de Agoramy', type: 'image' as const },
  { src: heroTienda.src, alt: 'Fachada de una tienda de abarrotes con el logo de Agoramy', type: 'image' as const },
];

// Un solo sistema, tres giros. El titular los escribe por turnos y los puntos
// fuertes cambian con cada palabra; la base del producto es la misma.
const sectors = [
  {
    id: 'farmacia',
    noun: 'farmacia',
    bullets: [
      'Control de inventario en tiempo real',
      'Facturación electrónica automática',
      'Alertas de caducidad de productos',
      'Reportes de ventas detallados',
      'Gestión de múltiples sucursales',
      'Control de recetas médicas',
    ],
  },
  {
    id: 'ferreteria',
    noun: 'ferretería',
    bullets: [
      'Inventario por clave, SKU y proveedor',
      'Facturación electrónica automática',
      'Venta a granel, por metro y por kilo',
      'Cotizaciones y ventas a crédito',
      'Gestión de múltiples sucursales',
      'Equivalencias entre marcas y medidas',
    ],
  },
  {
    id: 'tienda',
    noun: 'tienda',
    bullets: [
      'Cobro rápido con código de barras',
      'Facturación electrónica automática',
      'Control de caducidad y mermas',
      'Promociones 2x1 y por temporada',
      'Gestión de múltiples sucursales',
      'Apartados y ventas fiadas',
    ],
  },
];
---

<div>
  <section class="bg-gradient-to-t from-slate-500/10 relative">
    <section class="relative pt-6 md:pt-8 lg:pt-10 pb-16 md:pb-20 lg:pb-24">
      <div class="container mx-auto px-4">
        <div class="grid lg:grid-cols-2 grid-cols-1 gap-8 md:gap-12 items-center">
          <div class="order-2 lg:order-1">
            <div class="text-center sm:text-start">
              <h1 class="text-3xl/tight sm:text-3xl/tight md:text-4xl/tight lg:text-4xl/tight xl:text-5xl/tight font-semibold mb-5 md:mb-6">
                El sistema POS más
                <span class="relative z-0 after:bg-primary/50 after:-z-10 after:absolute md:after:h-6 after:h-4 after:w-full after:bottom-0 after:end-0">
                  completo
                </span>
                para tu
                <span class="sr-only">farmacia, ferretería o tienda</span>
                <!-- La palabra más larga, invisible, reserva el ancho para que la línea no se mueva. -->
                <span aria-hidden="true" class="inline-grid text-start whitespace-nowrap">
                  <span class="invisible [grid-area:1/1]">ferretería</span>
                  <span class="[grid-area:1/1] justify-self-start"><span id="sector-noun">farmacia</span><span class="sector-caret inline-block w-0.5 h-[0.9em] ms-1 align-[-0.1em] bg-primary motion-reduce:hidden"></span></span>
                </span>
              </h1>

              <p class="text-base md:text-lg text-gray-500 mb-6 md:mb-8">
                Agoramy es el sistema POS moderno para farmacias, ferreterías y tiendas
                en México. Un solo sistema, adaptado al giro de tu negocio.
              </p>

              <div class="flex flex-wrap gap-3 justify-center sm:justify-start mb-6">
                <a
                  href="/product"
                  class="bg-primary text-white rounded-lg text-sm font-semibold flex-none hover:shadow-lg hover:shadow-primary/30 focus:shadow-none focus:outline focus:outline-primary/40 px-6 py-3"
                >
                  Comenzar
                </a>
                <a
                  href="#sectores"
                  class="bg-white text-gray-700 border border-gray-300 rounded-lg text-sm font-semibold flex-none hover:border-gray-400 transition-all px-6 py-3"
                >
                  Ver mi giro
                </a>
              </div>

              <!-- Las tres listas ocupan la misma celda: la altura no cambia al pasar de una a otra. -->
              <div class="grid">
                {sectors.map((sector) => (
                  <div
                    data-sector-bullets={sector.id}
                    data-noun={sector.noun}
                    class:list={[
                      'grid sm:grid-cols-2 gap-3 [grid-area:1/1] transition-[opacity,visibility] duration-300 motion-reduce:transition-none',
                      sector.id !== 'farmacia' && 'invisible opacity-0',
                    ]}
                  >
                    {sector.bullets.map((bullet) => (
                      <div class="flex items-start gap-3">
                        <svg
                          class="stroke-primary stroke-2 w-5 h-5 flex-shrink-0 mt-0.5"
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="none"
                          aria-hidden="true"
                        >
                          <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <p class="text-sm text-gray-700">{bullet}</p>
                      </div>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          </div>

          <div class="order-1 lg:order-2">
            <div class="relative">
              <div class="hidden sm:block">
                <div class="before:w-24 before:h-24 before:absolute before:-bottom-8 before:-start-8 before:bg-[image:var(--dot2)]" style={dot2Style}></div>
                <div class="after:w-24 after:h-24 after:absolute after:-top-10 after:end-10 xl:after:end-5 2xl:after:end-0 after:rotate-45 after:bg-[image:var(--dot5)]" style={dot5Style}></div>
              </div>

              <div
                id="swiper_one"
                data-aos="fade-left"
                data-aos-duration="1000"
              >
                <SwiperSlider images={images} client:load />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="absolute bottom-0 inset-x-0 hidden sm:block">
      <img
        src={whiteWave.src}
        alt=""
        aria-hidden="true"
        class="w-full -scale-x-100 -scale-y-100"
      />
    </div>
  </section>
</div>

<style>
  .sector-caret {
    animation: sector-caret-blink 1s step-end infinite;
  }

  @keyframes sector-caret-blink {
    50% {
      opacity: 0;
    }
  }
</style>

<script>
  const HOLD_MS = 3000;
  const TYPE_MS = 90;
  const ERASE_MS = 45;

  const noun = document.getElementById('sector-noun');
  const groups = Array.from(
    document.querySelectorAll<HTMLElement>('[data-sector-bullets]')
  );
  const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

  function showBullets(active: HTMLElement) {
    for (const group of groups) {
      group.classList.toggle('invisible', group !== active);
      group.classList.toggle('opacity-0', group !== active);
    }
  }

  async function cycle(target: HTMLElement) {
    for (let index = 0; ; index = (index + 1) % groups.length) {
      const word = groups[index].dataset.noun ?? '';
      // La primera palabra ya viene escrita en el HTML; las demás se teclean.
      if (target.textContent !== word) {
        showBullets(groups[index]);
        document.dispatchEvent(new CustomEvent('hero:sector', { detail: index }));
        for (let length = 1; length <= word.length; length++) {
          target.textContent = word.slice(0, length);
          await wait(TYPE_MS);
        }
      }
      await wait(HOLD_MS);
      for (let length = word.length - 1; length >= 0; length--) {
        target.textContent = word.slice(0, length);
        await wait(ERASE_MS);
      }
    }
  }

  // Con movimiento reducido se queda la primera palabra, sin animación.
  if (noun && groups.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    cycle(noun);
  }
</script>
