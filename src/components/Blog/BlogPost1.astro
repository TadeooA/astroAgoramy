---
import { summary, tagClass, type Post } from './data';

interface Props {
	post: Post;
}

const { post } = Astro.props;
const href = post.slug ? `/blog/${post.slug}` : '#';
---

<article class="lg:col-span-2 group relative grid md:grid-cols-5 overflow-hidden border border-gray-300 bg-white rounded transition-all duration-300 hover:shadow-[0_0_1.5rem_0_rgba(0,0,0,.12)] hover:-translate-y-1">
	<div class="md:col-span-2 aspect-video md:aspect-auto overflow-hidden bg-gray-100">
		<img src={post.image} alt="" class="w-full h-full object-cover" />
	</div>
	<div class="md:col-span-3 p-6 flex flex-col">
		<div class="flex flex-wrap items-center gap-2 mb-3">
			<span class="text-xs font-medium uppercase tracking-wide text-gray-500">Destacado</span>
			<span class={`${tagClass(post.tag.value)} font-medium rounded-md text-xs py-1 px-2`}>
				{post.tag.value}
			</span>
		</div>
		<h2 class="text-xl/snug md:text-2xl/snug font-semibold text-gray-800 mb-3 transition-colors group-hover:text-primary">
			<a href={href} class="after:absolute after:inset-0">{post.title}</a>
		</h2>
		<p class="text-sm/relaxed text-gray-500 mb-6">{summary(post)}</p>
		<div class="mt-auto flex items-center gap-3">
			<img src={post.postedBy?.avatar} alt="" class="h-10 w-10 rounded-md" />
			<div>
				<p class="text-sm font-medium text-gray-800">{post.postedBy?.name}</p>
				<p class="text-xs text-gray-500">{post.postedOn?.date} · {post.postedOn?.time}</p>
			</div>
		</div>
	</div>
</article>
