---
import { summary, tagClass, type Post } from './data';

interface Props {
	post: Post;
}

const { post } = Astro.props;
const href = post.slug ? `/blog/${post.slug}` : '#';
---

<article class="group relative h-full flex flex-col overflow-hidden border border-gray-300 bg-white rounded transition-all duration-300 hover:shadow-[0_0_1.5rem_0_rgba(0,0,0,.12)] hover:-translate-y-1">
	<div class="aspect-video overflow-hidden bg-gray-100">
		<img src={post.image} alt="" loading="lazy" class="w-full h-full object-cover" />
	</div>
	<div class="p-5 flex flex-col flex-1">
		<div class="flex flex-wrap items-center justify-between gap-2 mb-3">
			<span class={`${tagClass(post.tag.value)} font-medium rounded-md text-xs py-1 px-2`}>
				{post.tag.value}
			</span>
			<span class="text-xs text-gray-500">{post.postedOn?.time}</span>
		</div>
		<h2 class="text-lg/snug font-semibold text-gray-800 mb-3 transition-colors group-hover:text-primary">
			<!-- El enlace del título cubre toda la tarjeta: un solo destino para teclado y lector de pantalla. -->
			<a href={href} class="after:absolute after:inset-0">{post.title}</a>
		</h2>
		<p class="text-sm/relaxed text-gray-500 line-clamp-3 mb-4">{summary(post)}</p>
		<div class="mt-auto flex flex-wrap items-center justify-between gap-2 text-xs">
			<span class="text-gray-500">{post.postedOn?.date}</span>
			<span class="font-medium text-primary" aria-hidden="true">
				Leer <i class="fa-solid fa-arrow-right ms-1 transition-transform group-hover:translate-x-1"></i>
			</span>
		</div>
	</div>
</article>
