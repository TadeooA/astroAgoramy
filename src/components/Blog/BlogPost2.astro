---
import type { Post } from './data';

interface Props {
	post: Post;
}

const { post } = Astro.props;
---

<div>
	<a href={post.slug ? `${import.meta.env.BASE_URL}/blog/${post.slug}` : '#'}>
		<img src={post.image} class="rounded-md mb-5 hover:opacity-90 transition-opacity" alt={post.title} />
	</a>
	<span class={`${post.tag.variant} font-medium rounded-md text-xs py-1 px-2`}>
		<a href={post.slug ? `${import.meta.env.BASE_URL}/blog/${post.slug}` : '#'}>{post.tag.value}</a>
	</span>
	<h1 class="text-lg my-3 transition-all hover:text-primary">
		<a href={post.slug ? `${import.meta.env.BASE_URL}/blog/${post.slug}` : '#'}>{post.title}</a>
	</h1>
	<p class="text-sm/relaxed tracking-wider text-gray-500">
		{post.description}{' '}
		<a href={post.slug ? `${import.meta.env.BASE_URL}/blog/${post.slug}` : '#'} class="text-primary">
			leer más
		</a>
	</p>
</div>
