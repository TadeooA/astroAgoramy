---
import PageHeader from '../Common/PageHeader.astro';
---

<PageHeader
  title="¿Cómo podemos"
  highlight="ayudarte"
  titleAfter="?"
  subtitle="Busca en la base de conocimiento o entra por categoría."
>
  <div class="max-w-xl mx-auto mt-8">
    <div class="relative">
      <input
        type="text"
        placeholder="Buscar artículos..."
        class="w-full py-4 px-6 pr-12 bg-white border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/50"
      />
      <button
        type="button"
        aria-label="Buscar"
        class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-primary"
      >
        <i class="fa-solid fa-search text-xl"></i>
      </button>
    </div>
  </div>
</PageHeader>
