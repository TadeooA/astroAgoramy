---
// SupportCenter component for Help page
---

<div class="lg:col-span-1">
  <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100 sticky top-6">
    <h3 class="text-xl font-semibold mb-6">Centro de Soporte</h3>
    <div class="space-y-4">
      <div class="flex items-start gap-4 p-4 bg-primary/5 rounded-lg">
        <div class="w-10 h-10 bg-primary/20 rounded-lg flex items-center justify-center flex-shrink-0">
          <i class="fa-solid fa-envelope text-primary"></i>
        </div>
        <div>
          <h5 class="font-semibold mb-1">Soporte por Correo Electrónico</h5>
          <p class="text-sm text-gray-600 mb-2">Responderemos en 24 horas</p>
          <a href="mailto:support@prompt.com" class="text-primary text-sm hover:underline">
            support@prompt.com
          </a>
        </div>
      </div>
      <div class="flex items-start gap-4 p-4 bg-primary/5 rounded-lg">
        <div class="w-10 h-10 bg-primary/20 rounded-lg flex items-center justify-center flex-shrink-0">
          <i class="fa-solid fa-comments text-primary"></i>
        </div>
        <div>
          <h5 class="font-semibold mb-1">Chat en Vivo</h5>
          <p class="text-sm text-gray-600 mb-2">Chatea con nuestro equipo de soporte</p>
          <button class="text-primary text-sm hover:underline">
            Iniciar Chat
          </button>
        </div>
      </div>
      <div class="flex items-start gap-4 p-4 bg-primary/5 rounded-lg">
        <div class="w-10 h-10 bg-primary/20 rounded-lg flex items-center justify-center flex-shrink-0">
          <i class="fa-solid fa-phone text-primary"></i>
        </div>
        <div>
          <h5 class="font-semibold mb-1">Soporte Telefónico</h5>
          <p class="text-sm text-gray-600 mb-2">Lun-Vie, 9am-6pm EST</p>
          <a href="tel:+1234567890" class="text-primary text-sm hover:underline">
            +1 (234) 567-890
          </a>
        </div>
      </div>
    </div>
    <div class="mt-8 p-4 bg-gray-50 rounded-lg">
      <h5 class="font-semibold mb-2">¿Necesitas más ayuda?</h5>
      <p class="text-sm text-gray-600 mb-4">
        Nuestro equipo está siempre listo para ayudarte con cualquier pregunta o problema
      </p>
      <a
        href="/contact"
        class="block w-full text-center py-2 px-4 bg-primary text-white rounded hover:shadow-lg transition-all"
      >
        Contáctanos
      </a>
    </div>
  </div>
</div>
