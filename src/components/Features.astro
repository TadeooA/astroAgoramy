---
import FeaturesAccordion from './FeaturesAccordion.tsx';

// images
import sass1 from '../assets/saas1.webp';
import sass2 from '../assets/saas2.jpg';
import feature2w from '../assets/images/features/feature2w.webp';
import feature3w from '../assets/images/features/feature3w.webp';
import feature4w from '../assets/images/features/feature4w.webp';
import feature5w from '../assets/images/features/feature5w.webp';
import feature6w from '../assets/images/features/feature6w.webp';
import feature7w from '../assets/images/features/feature7w.webp';

const accordionItems = [
  {
    icon: `<svg class="h-6 w-6 text-blue-500" viewBox="0 0 24 24" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlnsXlink="http://www.w3.org/1999/xlink"><g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd"><polygon points="0 0 24 0 24 24 0 24"></polygon><path d="M18,14 C16.3431458,14 15,12.6568542 15,11 C15,9.34314575 16.3431458,8 18,8 C19.6568542,8 21,9.34314575 21,11 C21,12.6568542 19.6568542,14 18,14 Z M9,11 C6.790861,11 5,9.209139 5,7 C5,4.790861 6.790861,3 9,3 C11.209139,3 13,4.790861 13,7 C13,9.209139 11.209139,11 9,11 Z" fill="currentColor" opacity="0.3"></path><path d="M17.6011961,15.0006174 C21.0077043,15.0378534 23.7891749,16.7601418 23.9984937,20.4 C24.0069246,20.5466056 23.9984937,21 23.4559499,21 L19.6,21 C19.6,18.7490654 18.8562935,16.6718327 17.6011961,15.0006174 Z M0.00065168429,20.1992055 C0.388258525,15.4265159 4.26191235,13 8.98334134,13 C13.7712164,13 17.7048837,15.2931929 17.9979143,20.2 C18.0095879,20.3954741 17.9979143,21 17.2466999,21 C13.541124,21 8.03472472,21 0.727502227,21 C0.476712155,21 -0.0204617505,20.45918 0.00065168429,20.1992055 Z" fill="currentColor"></path></g></svg>`,
    iconColor: 'text-blue-500',
    iconBgColor: 'bg-blue-500/10',
    title: 'Gestión de Clientes y Ventas',
    description: 'Control total de tus clientes, historial de compras, recetas médicas y programas de lealtad. Gestiona ventas presenciales y en línea desde una sola plataforma.',
  },
  {
    icon: `<svg class="h-6 w-6 text-green-500" viewBox="0 0 24 24" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlnsXlink="http://www.w3.org/1999/xlink"><g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd"><polygon points="0 0 24 0 24 24 0 24"></polygon><path d="M18,8 L16,8 C15.4477153,8 15,7.55228475 15,7 C15,6.44771525 15.4477153,6 16,6 L18,6 L18,4 C18,3.44771525 18.4477153,3 19,3 C19.5522847,3 20,3.44771525 20,4 L20,6 L22,6 C22.5522847,6 23,6.44771525 23,7 C23,7.55228475 22.5522847,8 22,8 L20,8 L20,10 C20,10.5522847 19.5522847,11 19,11 C18.4477153,11 18,10.5522847 18,10 L18,8 Z M9,11 C6.790861,11 5,9.209139 5,7 C5,4.790861 6.790861,3 9,3 C11.209139,3 13,4.790861 13,7 C13,9.209139 11.209139,11 9,11 Z" fill="currentColor" opacity="0.3"></path><path d="M0.00065168429,20.1992055 C0.388258525,15.4265159 4.26191235,13 8.98334134,13 C13.7712164,13 17.7048837,15.2931929 17.9979143,20.2 C18.0095879,20.3954741 17.9979143,21 17.2466999,21 C13.541124,21 8.03472472,21 0.727502227,21 C0.476712155,21 -0.0204617505,20.45918 0.00065168429,20.1992055 Z" fill="currentColor"></path></g></svg>`,
    iconColor: 'text-green-500',
    iconBgColor: 'bg-green-500/10',
    title: 'Inventario Inteligente',
    description: 'Administra tu inventario con control de lotes, fechas de caducidad, alertas automáticas de reorden y seguimiento en tiempo real. Compatible con lectores de código de barras.',
  },
  {
    icon: `<svg class="h-6 w-6 text-orange-500" viewBox="0 0 24 24" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlnsXlink="http://www.w3.org/1999/xlink"><g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd"><rect x="0" y="0" width="24" height="24"></rect><rect fill="currentColor" opacity="0.3" x="7" y="4" width="3" height="13" rx="1.5"></rect><rect fill="currentColor" opacity="0.3" x="12" y="9" width="3" height="8" rx="1.5"></rect><path d="M5,19 L20,19 C20.5522847,19 21,19.4477153 21,20 C21,20.5522847 20.5522847,21 20,21 L4,21 C3.44771525,21 3,20.5522847 3,20 L3,4 C3,3.44771525 3.44771525,3 4,3 C4.55228475,3 5,3.44771525 5,4 L5,19 Z" fill="currentColor"></path><rect fill="currentColor" opacity="0.3" x="17" y="11" width="3" height="6" rx="1.5"></rect></g></svg>`,
    iconColor: 'text-orange-500',
    iconBgColor: 'bg-orange-500/10',
    title: 'Reportes y Análisis',
    description: 'Toma decisiones informadas con reportes detallados de ventas, inventario, productos más vendidos, análisis de rentabilidad y proyecciones de negocio.',
  },
];

const featuresList = [
  'Punto de Venta Rápido',
  'Control de Inventario',
  'Gestión de Recetas',
  'Facturación Electrónica',
  'Reportes en Tiempo Real',
  'Multi-sucursal',
  'Alertas de Caducidad',
  'Programa de Lealtad',
  'Control de Empleados',
  'Integración Contable',
  'Integración con Terminal Bancaria',
  'Control de Caducidades',
  'Gestión de Personal',
  'Soporte 24/7',
  'Personalización de Recibos',
];
---

<section class="overflow-hidden">
  <div class="xl:py-24 py-16">
    <div class="container mx-auto px-4">
      <div class="text-center">
        <span class="text-sm font-medium py-1 px-3 rounded-full text-green-500 bg-green-500/10">
          Características
        </span>
        <h1 class="text-3xl/tight font-medium mt-3 mb-4">
          Mejor Gestión. Mejores Resultados
        </h1>
        <p class="text-gray-500">
          Comienza a trabajar con <span class="text-green-500">Agoramy</span> para administrar tu farmacia de manera profesional
        </p>
      </div>

      <div class="xl:pt-16 xl:pb-28 py-16">
        <div class="grid lg:grid-cols-2 grid-cols-1 gap-6 items-center">
          <div class="relative">
            <div class="hidden sm:block">
              <div class="after:w-20 after:h-20 after:absolute after:-top-8 after:-start-8 2xl:after:end-0 after:bg-[url('/src/assets/images/pattern/dot5.svg')]"></div>
              <div class="before:w-20 before:h-20 before:absolute before:-bottom-8 before:-end-8 before:bg-[url('/src/assets/images/pattern/dot2.svg')]"></div>
            </div>
            <img
              src={sass1.src}
              alt="saas1"
              data-aos="fade-right"
              data-aos-duration="400"
            />
          </div>

          <div class="lg:ms-24">
            <div data-aos="fade-up" data-aos-duration="500">
              <FeaturesAccordion items={accordionItems} client:load />
            </div>
          </div>
        </div>
      </div>

      <!-- Sección Control de Medicamentos -->
      <div class="xl:pt-16 xl:pb-16 py-16">
        <div class="grid lg:grid-cols-2 grid-cols-1 gap-6 items-center">
          <div
            class="2xl:w-9/12"
            data-aos="fade-up"
            data-aos-duration="500"
          >
            <div class="h-12 w-12 bg-red-500/10 flex items-center justify-center rounded-lg">
              <i class="fa-solid fa-pills text-red-500 text-2xl"></i>
            </div>

            <h1 class="text-3xl/tight font-medium mt-6 mb-4">
              Control de Medicamentos Controlados
            </h1>
            <p class="text-gray-500 mb-4">
              Cumple con todas las normativas de COFEPRIS para el manejo de medicamentos controlados. Registro completo, trazabilidad y reportes automáticos.
            </p>
            <div class="space-y-3">
              <div class="flex items-start gap-3">
                <i class="fa-solid fa-shield-alt text-red-500 text-lg mt-1"></i>
                <div>
                  <p class="font-semibold text-gray-700">Registro Completo COFEPRIS</p>
                  <p class="text-gray-500 text-sm">Control y registro de medicamentos psicotrópicos y estupefacientes</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <i class="fa-solid fa-clipboard-list text-red-500 text-lg mt-1"></i>
                <div>
                  <p class="font-semibold text-gray-700">Trazabilidad Completa</p>
                  <p class="text-gray-500 text-sm">Seguimiento de lote, caducidad y recetas médicas</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <i class="fa-solid fa-file-alt text-red-500 text-lg mt-1"></i>
                <div>
                  <p class="font-semibold text-gray-700">Reportes Automáticos</p>
                  <p class="text-gray-500 text-sm">Genera reportes requeridos por autoridades sanitarias</p>
                </div>
              </div>
            </div>
            <div class="flex items-center mt-8">
              <a href="#" class="text-red-500">
                Conocer más <i class="fa-solid fa-arrow-right ms-2"></i>
              </a>
            </div>
          </div>

          <div class="relative">
            <div class="hidden sm:block">
              <div class="after:w-20 after:h-20 after:absolute after:-top-8 after:-end-8 2xl:after:-end-8 after:bg-[url('/src/assets/images/pattern/dot2.svg')]"></div>
              <div class="before:w-20 before:h-20 before:absolute before:-bottom-8 before:-start-8 before:bg-[url('/src/assets/images/pattern/dot5.svg')]"></div>
            </div>

            <img
              src={feature2w.src}
              alt="Control de Medicamentos"
              data-aos="fade-left"
              data-aos-duration="400"
            />
          </div>
        </div>
      </div>

      <!-- Sección Gestión de Empleados y Permisos -->
      <div class="xl:pb-16 py-16">
        <div class="grid lg:grid-cols-2 grid-cols-1 gap-6 items-center">
          <div class="relative order-2 lg:order-1">
            <div class="hidden sm:block">
              <div class="after:w-20 after:h-20 after:absolute after:-top-8 after:-start-8 2xl:after:end-0 after:bg-[url('/src/assets/images/pattern/dot5.svg')]"></div>
              <div class="before:w-20 before:h-20 before:absolute before:-bottom-8 before:-end-8 before:bg-[url('/src/assets/images/pattern/dot2.svg')]"></div>
            </div>
            <img
              src={feature3w.src}
              alt="Gestión de Empleados"
              data-aos="fade-right"
              data-aos-duration="400"
            />
          </div>

          <div
            class="2xl:w-9/12 lg:ms-auto order-1 lg:order-2"
            data-aos="fade-up"
            data-aos-duration="500"
          >
            <div class="h-12 w-12 bg-purple-500/10 flex items-center justify-center rounded-lg">
              <i class="fa-solid fa-users-cog text-purple-500 text-2xl"></i>
            </div>

            <h1 class="text-3xl/tight font-medium mt-6 mb-4">
              Gestión de Empleados y Permisos
            </h1>
            <p class="text-gray-500 mb-4">
              Administra tu equipo de trabajo con control de accesos, permisos personalizados y registro de actividades para mayor seguridad y transparencia.
            </p>
            <div class="space-y-3">
              <div class="flex items-start gap-3">
                <i class="fa-solid fa-user-shield text-purple-500 text-lg mt-1"></i>
                <div>
                  <p class="font-semibold text-gray-700">Control de Accesos por Rol</p>
                  <p class="text-gray-500 text-sm">Define permisos específicos para cada empleado</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <i class="fa-solid fa-clock text-purple-500 text-lg mt-1"></i>
                <div>
                  <p class="font-semibold text-gray-700">Registro de Horarios</p>
                  <p class="text-gray-500 text-sm">Control de entrada/salida y turnos de trabajo</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <i class="fa-solid fa-history text-purple-500 text-lg mt-1"></i>
                <div>
                  <p class="font-semibold text-gray-700">Auditoría de Actividades</p>
                  <p class="text-gray-500 text-sm">Historial completo de acciones realizadas</p>
                </div>
              </div>
            </div>
            <div class="flex items-center mt-8">
              <a href="#" class="text-purple-500">
                Conocer más <i class="fa-solid fa-arrow-right ms-2"></i>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Sección Catálogo Digital y Gestión de Compras -->
      <div class="xl:pb-16 py-16">
        <div class="grid lg:grid-cols-2 grid-cols-1 gap-6 items-center">
          <div
            class="2xl:w-9/12"
            data-aos="fade-up"
            data-aos-duration="500"
          >
            <div class="h-12 w-12 bg-indigo-500/10 flex items-center justify-center rounded-lg">
              <i class="fa-solid fa-truck text-indigo-500 text-2xl"></i>
            </div>

            <h1 class="text-3xl/tight font-medium mt-6 mb-4">
              Catálogo Digital, Gestión de Compras y Envíos
            </h1>
            <p class="text-gray-500 mb-4">
              Optimiza tus procesos de compra con catálogos digitales, órdenes automatizadas a proveedores y gestión completa de envíos a domicilio.
            </p>
            <div class="space-y-3">
              <div class="flex items-start gap-3">
                <i class="fa-solid fa-book text-indigo-500 text-lg mt-1"></i>
                <div>
                  <p class="font-semibold text-gray-700">Catálogo Digital Completo</p>
                  <p class="text-gray-500 text-sm">Base de datos actualizada de productos y proveedores</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <i class="fa-solid fa-shopping-cart text-indigo-500 text-lg mt-1"></i>
                <div>
                  <p class="font-semibold text-gray-700">Órdenes de Compra Automatizadas</p>
                  <p class="text-gray-500 text-sm">Genera órdenes cuando el inventario alcanza el punto de reorden</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <i class="fa-solid fa-shipping-fast text-indigo-500 text-lg mt-1"></i>
                <div>
                  <p class="font-semibold text-gray-700">Control de Envíos</p>
                  <p class="text-gray-500 text-sm">Gestión de entregas a domicilio con seguimiento en tiempo real</p>
                </div>
              </div>
            </div>
            <div class="flex items-center mt-8">
              <a href="#" class="text-indigo-500">
                Conocer más <i class="fa-solid fa-arrow-right ms-2"></i>
              </a>
            </div>
          </div>

          <div class="relative">
            <div class="hidden sm:block">
              <div class="after:w-20 after:h-20 after:absolute after:-top-8 after:-end-8 2xl:after:-end-8 after:bg-[url('/src/assets/images/pattern/dot2.svg')]"></div>
              <div class="before:w-20 before:h-20 before:absolute before:-bottom-8 before:-start-8 before:bg-[url('/src/assets/images/pattern/dot5.svg')]"></div>
            </div>

            <img
              src={feature4w.src}
              alt="Gestión de Compras"
              data-aos="fade-left"
              data-aos-duration="400"
            />
          </div>
        </div>
      </div>

      <!-- Sección Facturación Electrónica México -->
      <div class="xl:pb-16 py-16">
        <div class="grid lg:grid-cols-2 grid-cols-1 gap-6 items-center">
          <div class="relative order-2 lg:order-1">
            <div class="hidden sm:block">
              <div class="after:w-20 after:h-20 after:absolute after:-top-8 after:-start-8 2xl:after:end-0 after:bg-[url('/src/assets/images/pattern/dot5.svg')]"></div>
              <div class="before:w-20 before:h-20 before:absolute before:-bottom-8 before:-end-8 before:bg-[url('/src/assets/images/pattern/dot2.svg')]"></div>
            </div>
            <img
              src={feature5w.src}
              alt="Facturación Electrónica"
              data-aos="fade-right"
              data-aos-duration="400"
            />
          </div>

          <div
            class="2xl:w-9/12 lg:ms-auto order-1 lg:order-2"
            data-aos="fade-up"
            data-aos-duration="500"
          >
            <div class="h-12 w-12 bg-green-500/10 flex items-center justify-center rounded-lg">
              <i class="fa-solid fa-file-invoice-dollar text-green-500 text-2xl"></i>
            </div>

            <h1 class="text-3xl/tight font-medium mt-6 mb-4">
              Facturación Electrónica México - CFDI 4.0
            </h1>
            <p class="text-gray-500 mb-4">
              Genera facturas electrónicas automáticamente cumpliendo con todas las normativas del SAT. Sistema actualizado a CFDI 4.0 con timbrado en tiempo real.
            </p>
            <div class="space-y-3">
              <div class="flex items-start gap-3">
                <i class="fa-solid fa-check-circle text-green-500 text-lg mt-1"></i>
                <div>
                  <p class="font-semibold text-gray-700">CFDI 4.0 Actualizado</p>
                  <p class="text-gray-500 text-sm">Cumple con la última versión del SAT</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <i class="fa-solid fa-bolt text-green-500 text-lg mt-1"></i>
                <div>
                  <p class="font-semibold text-gray-700">Timbrado Automático</p>
                  <p class="text-gray-500 text-sm">Genera y timbra facturas en segundos</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <i class="fa-solid fa-envelope text-green-500 text-lg mt-1"></i>
                <div>
                  <p class="font-semibold text-gray-700">Envío Automático por Email</p>
                  <p class="text-gray-500 text-sm">Entrega facturas PDF y XML a tus clientes</p>
                </div>
              </div>
            </div>
            <div class="flex items-center mt-8">
              <a href="#" class="text-green-500">
                Conocer más <i class="fa-solid fa-arrow-right ms-2"></i>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Sección Gestión de Promociones y Ofertas -->
      <div class="xl:pb-16 py-16">
        <div class="grid lg:grid-cols-2 grid-cols-1 gap-6 items-center">
          <div
            class="2xl:w-9/12"
            data-aos="fade-up"
            data-aos-duration="500"
          >
            <div class="h-12 w-12 bg-yellow-500/10 flex items-center justify-center rounded-lg">
              <i class="fa-solid fa-tags text-yellow-500 text-2xl"></i>
            </div>

            <h1 class="text-3xl/tight font-medium mt-6 mb-4">
              Gestión de Promociones y Ofertas
            </h1>
            <p class="text-gray-500 mb-4">
              Crea promociones, descuentos y programas de lealtad para aumentar tus ventas. Sistema flexible que se adapta a cualquier estrategia comercial.
            </p>
            <div class="space-y-3">
              <div class="flex items-start gap-3">
                <i class="fa-solid fa-percent text-yellow-500 text-lg mt-1"></i>
                <div>
                  <p class="font-semibold text-gray-700">Descuentos Programables</p>
                  <p class="text-gray-500 text-sm">2x1, 3x2, descuentos por volumen y más</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <i class="fa-solid fa-gift text-yellow-500 text-lg mt-1"></i>
                <div>
                  <p class="font-semibold text-gray-700">Programa de Lealtad</p>
                  <p class="text-gray-500 text-sm">Acumula puntos y recompensa a tus clientes frecuentes</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <i class="fa-solid fa-calendar-alt text-yellow-500 text-lg mt-1"></i>
                <div>
                  <p class="font-semibold text-gray-700">Promociones Temporales</p>
                  <p class="text-gray-500 text-sm">Define ofertas por fecha, hora o temporada</p>
                </div>
              </div>
            </div>
            <div class="flex items-center mt-8">
              <a href="#" class="text-yellow-500">
                Conocer más <i class="fa-solid fa-arrow-right ms-2"></i>
              </a>
            </div>
          </div>

          <div class="relative">
            <div class="hidden sm:block">
              <div class="after:w-20 after:h-20 after:absolute after:-top-8 after:-end-8 2xl:after:-end-8 after:bg-[url('/src/assets/images/pattern/dot2.svg')]"></div>
              <div class="before:w-20 before:h-20 before:absolute before:-bottom-8 before:-start-8 before:bg-[url('/src/assets/images/pattern/dot5.svg')]"></div>
            </div>

            <img
              src={feature6w.src}
              alt="Promociones y Ofertas"
              data-aos="fade-left"
              data-aos-duration="400"
            />
          </div>
        </div>
      </div>

      <!-- Sección Analítica de Empleados, Ventas y Compras -->
      <div class="xl:pb-16 py-16">
        <div class="grid lg:grid-cols-2 grid-cols-1 gap-6 items-center">
          <div class="relative order-2 lg:order-1">
            <div class="hidden sm:block">
              <div class="after:w-20 after:h-20 after:absolute after:-top-8 after:-start-8 2xl:after:end-0 after:bg-[url('/src/assets/images/pattern/dot5.svg')]"></div>
              <div class="before:w-20 before:h-20 before:absolute before:-bottom-8 before:-end-8 before:bg-[url('/src/assets/images/pattern/dot2.svg')]"></div>
            </div>
            <img
              src={feature7w.src}
              alt="Analítica Avanzada"
              data-aos="fade-right"
              data-aos-duration="400"
            />
          </div>

          <div
            class="2xl:w-9/12 lg:ms-auto order-1 lg:order-2"
            data-aos="fade-up"
            data-aos-duration="500"
          >
            <div class="h-12 w-12 bg-blue-500/10 flex items-center justify-center rounded-lg">
              <i class="fa-solid fa-chart-line text-blue-500 text-2xl"></i>
            </div>

            <h1 class="text-3xl/tight font-medium mt-6 mb-4">
              Analítica de Empleados, Ventas y Compras
            </h1>
            <p class="text-gray-500 mb-4">
              Toma decisiones basadas en datos con reportes detallados de rendimiento, ventas y eficiencia operativa. Visualiza métricas clave en tiempo real.
            </p>
            <div class="space-y-3">
              <div class="flex items-start gap-3">
                <i class="fa-solid fa-chart-bar text-blue-500 text-lg mt-1"></i>
                <div>
                  <p class="font-semibold text-gray-700">Dashboard en Tiempo Real</p>
                  <p class="text-gray-500 text-sm">Métricas de ventas, inventario y rendimiento al instante</p>
                </div>
