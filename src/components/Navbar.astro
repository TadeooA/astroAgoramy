---
import logo from '@/assets/agoramyLandingw.webp';

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/company', label: 'Quiénes Somos' },
  { href: '/career', label: 'Carreras' },
  { href: '/pricing', label: 'Precios' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Contacto' },
];

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

// "page" solo en la página exacta; un artículo del blog marca Blog como su sección.
function currentState(href: string) {
  if (path === href) return 'page';
  if (href !== '/' && path.startsWith(`${href}/`)) return 'true';
  return undefined;
}
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-white border-b-0 transition-all duration-300">
  <div class="container mx-auto px-4">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <div class="flex-shrink-0">
        <a href="/">
          <img id="navbar-logo" src={logo.src} alt="Agoramy" class="h-[54px] transition-all duration-300" />
        </a>
      </div>

      <!-- Desktop Navigation -->
      <div id="nav-links" class="relative hidden lg:flex items-center">
        <span
          id="nav-hover"
          aria-hidden="true"
          class="absolute inset-y-0 left-0 rounded-md bg-green-500/10 opacity-0 pointer-events-none transition-[transform,width,opacity] duration-200 ease-out motion-reduce:transition-none"
        ></span>
        {links.map((link) => {
          const current = currentState(link.href);
          return (
            <a
              href={link.href}
              aria-current={current}
              class:list={[
                'relative z-10 px-4 py-2 transition-colors font-medium hover:text-green-600',
                current
                  ? "text-green-600 after:absolute after:inset-x-4 after:bottom-0 after:h-0.5 after:rounded-full after:bg-green-500 after:content-['']"
                  : 'text-gray-700',
              ]}
            >
              {link.label}
            </a>
          );
        })}
      </div>

      <!-- CTA Buttons -->
      <div class="hidden lg:flex items-center space-x-4">

        <a
          href="/product"
          class="bg-green-500 text-white px-6 py-2 rounded-lg hover:bg-green-600 hover:shadow-lg hover:shadow-green-500/30 transition-all font-medium"
        >
          Registrarse
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        class="lg:hidden p-2 rounded-lg hover:bg-gray-100 transition-colors"
        aria-label="Toggle menu"
      >
        <svg
          class="w-6 h-6 text-gray-700"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          ></path>
        </svg>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div
      id="mobile-menu"
      class="hidden lg:hidden pb-4 border-t border-gray-200 mt-2 bg-white"
    >
      <div class="flex flex-col space-y-3 pt-4">
        {links.map((link) => {
          const current = currentState(link.href);
          return (
            <a
              href={link.href}
              aria-current={current}
              class:list={[
                'hover:text-green-500 transition-colors font-medium py-2',
                current ? 'text-green-600 border-s-2 border-green-500 ps-3' : 'text-gray-700',
              ]}
            >
              {link.label}
            </a>
          );
        })}
        <div class="flex flex-col space-y-2 pt-2">

          <a
            href="/product"
            class="text-center bg-green-500 text-white px-6 py-2 rounded-lg hover:bg-green-600 transition-all font-medium"
          >
            Registrarse
          </a>
        </div>
      </div>
    </div>
  </div>
</nav>

<!-- Spacer to prevent content from hiding under fixed navbar -->
<div class="h-20"></div>

<script>
  // Mobile menu functionality
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileMenuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Close mobile menu when clicking on a link
  const mobileLinks = mobileMenu?.querySelectorAll('a');
  mobileLinks?.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
    });
  });

  // Fondo que se desliza entre los enlaces de escritorio (hover y teclado)
  const navLinks = document.getElementById('nav-links');
  const navHover = document.getElementById('nav-hover');

  if (navLinks && navHover) {
    const moveTo = (link: HTMLElement) => {
      const wasHidden = navHover.style.opacity !== '1';
      // Al entrar desde fuera aparece sobre el enlace, sin viajar desde su última posición.
      if (wasHidden) navHover.style.transition = 'none';
      navHover.style.width = `${link.offsetWidth}px`;
      navHover.style.transform = `translateX(${link.offsetLeft}px)`;
      if (wasHidden) {
        void navHover.offsetWidth;
        navHover.style.transition = '';
      }
      navHover.style.opacity = '1';
    };
    const hide = () => {
      navHover.style.opacity = '0';
    };

    navLinks.querySelectorAll('a').forEach((link) => {
      link.addEventListener('mouseenter', () => moveTo(link));
      link.addEventListener('focus', () => {
        if (link.matches(':focus-visible')) moveTo(link);
      });
      link.addEventListener('blur', hide);
    });
    navLinks.addEventListener('mouseleave', hide);
  }
</script>
